		<Methods>
			<Method>
				<Name>findByInvoiceTier</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the notification log line of an invoice and an overdue tier.
    /// </summary>
    /// <param name = "_custInvoiceJourRecId">The record ID of the customer invoice journal.</param>
    /// <param name = "_tierDays">The days of the overdue tier.</param>
    /// <param name = "_forUpdate">true to select the record for update.</param>
    /// <returns>The log line, or an empty buffer.</returns>
    public static DYLO_OverdueInvoiceNotificationLog findByInvoiceTier(RefRecId _custInvoiceJourRecId, Days _tierDays, boolean _forUpdate = false)
    {
        DYLO_OverdueInvoiceNotificationLog log;

        if (_custInvoiceJourRecId)
        {
            log.selectForUpdate(_forUpdate);

            select firstonly log
                where log.CustInvoiceJourRecId == _custInvoiceJourRecId
                   && log.TierDays             == _tierDays;
        }

        return log;
    }

]]></Source>
			</Method>
		</Methods>
