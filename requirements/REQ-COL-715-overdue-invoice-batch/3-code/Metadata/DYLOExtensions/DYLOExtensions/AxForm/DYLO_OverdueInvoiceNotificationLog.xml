				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            this.queryBuildDataSource().addSortField(fieldNum(DYLO_OverdueInvoiceNotificationLog, CreatedDateTime), SortOrder::Descending);
            statusRange = this.queryBuildDataSource().addRange(fieldNum(DYLO_OverdueInvoiceNotificationLog, Status));
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            switch (StatusFilter.selection())
            {
                case DYLO_OverdueNotificationStatusFilter::Sent:
                    statusRange.value(queryValue(DYLO_OverdueNotificationStatus::Sent));
                    break;

                case DYLO_OverdueNotificationStatusFilter::Failed:
                    statusRange.value(queryValue(DYLO_OverdueNotificationStatus::Failed));
                    break;

                default:
                    statusRange.value(SysQuery::valueUnlimited());
                    break;
            }

            super();

            element.updateCounts();
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();

            Details_ErrorText.visible(DYLO_OverdueInvoiceNotificationLog.Status == DYLO_OverdueNotificationStatus::Failed
                || DYLO_OverdueInvoiceNotificationLog.ErrorText != '');

            return ret;
        }

]]></Source>
					</Method>
					<Method>
						<Name>displayOption</Name>
						<Source><![CDATA[
        public void displayOption(Common _record, FormRowDisplayOption _options)
        {
            DYLO_OverdueInvoiceNotificationLog log = _record;

            if (log.Status == DYLO_OverdueNotificationStatus::Sent)
            {
                _options.backColor(WinAPI::rgb2int(230, 244, 234));
                _options.textColor(WinAPI::rgb2int(30, 123, 52));
            }
            else
            {
                _options.backColor(WinAPI::rgb2int(253, 226, 226));
                _options.textColor(WinAPI::rgb2int(198, 40, 40));
            }

            _options.affectedElementsByControl(LogGrid_Status.id());

            super(_record, _options);
        }

]]></Source>
