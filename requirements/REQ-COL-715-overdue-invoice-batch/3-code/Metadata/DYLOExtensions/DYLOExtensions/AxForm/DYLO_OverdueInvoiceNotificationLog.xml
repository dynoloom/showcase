			</Method>
			<Method>
				<Name>updateCounts</Name>
				<Source><![CDATA[
    /// <summary>
    /// Shows the number of all, sent and failed notification log lines.
    /// </summary>
    public void updateCounts()
    {
        DYLO_OverdueInvoiceNotificationLog log;
        int64                              allCount;
        int64                              sentCount;
        int64                              failedCount;

        select count(RecId) from log;
        allCount = log.RecId;

        select count(RecId) from log
            where log.Status == DYLO_OverdueNotificationStatus::Sent;
        sentCount = log.RecId;

        select count(RecId) from log
            where log.Status == DYLO_OverdueNotificationStatus::Failed;
        failedCount = log.RecId;

        StatusCounts.text(strFmt("@DYLOExtensions:OverdueInvNotifCounts", allCount, sentCount, failedCount));
    }

]]></Source>
			</Method>
		</Methods>
