+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>initValue</Name>
+				<Source><![CDATA[
+    public void initValue()
+    {
+        super();
+
+        this.Active = NoYes::Yes;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>validateField</Name>
+				<Source><![CDATA[
+    public boolean validateField(FieldId _fieldIdToCheck)
+    {
+        boolean ret = super(_fieldIdToCheck);
+
+        if (ret && _fieldIdToCheck == fieldNum(DYLO_OverdueNotificationTier, TierDays))
+        {
+            ret = this.checkTierDays();
+        }
+
+        return ret;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>validateWrite</Name>
+				<Source><![CDATA[
+    public boolean validateWrite()
+    {
+        boolean ret = super();
+
+        if (ret)
+        {
+            ret = this.checkTierDays();
+        }
+
+        return ret;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>checkTierDays</Name>
+				<Source><![CDATA[
+    private boolean checkTierDays()
+    {
+        DYLO_OverdueNotificationTier other;
+
+        if (this.TierDays <= 0)
+        {
+            return checkFailed("@DYLOExtensions:OverdueInvNotifErrTierDays");
+        }
+
+        select firstonly RecId from other
+            where other.TierDays == this.TierDays
+               && other.RecId    != this.RecId;
+
+        if (other.RecId)
+        {
+            return checkFailed(strFmt("@DYLOExtensions:OverdueInvNotifTierExists", this.TierDays));
+        }
+
+        return true;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>find</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Finds an overdue tier by its number of days.
+    /// </summary>
+    /// <param name = "_days">The days overdue of the tier.</param>
+    /// <param name = "_forUpdate">true to select the record for update.</param>
+    /// <returns>The tier, or an empty buffer.</returns>
+    public static DYLO_OverdueNotificationTier find(Days _days, boolean _forUpdate = false)
+    {
+        DYLO_OverdueNotificationTier tier;
+
+        if (_days)
+        {
+            tier.selectForUpdate(_forUpdate);
+
+            select firstonly tier
+                where tier.TierDays == _days;
+        }
+
+        return tier;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>exist</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Checks whether an overdue tier exists.
+    /// </summary>
+    /// <param name = "_days">The days overdue of the tier.</param>
+    /// <returns>true if the tier exists; otherwise, false.</returns>
+    public static boolean exist(Days _days)
+    {
+        return _days
+            && (select firstonly RecId from dYLO_OverdueNotificationTier
+                    where dYLO_OverdueNotificationTier.TierDays == _days).RecId != 0;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>hasActiveTier</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Checks whether at least one active overdue tier exists.
+    /// </summary>
+    /// <returns>true if an active tier exists; otherwise, false.</returns>
+    public static boolean hasActiveTier()
+    {
+        DYLO_OverdueNotificationTier tier;
+
+        select firstonly RecId from tier
+            where tier.Active == NoYes::Yes;
+
+        return tier.RecId != 0;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>highestReachedTier</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Finds the highest active tier that an invoice with the given days overdue has reached.
+    /// </summary>
+    /// <param name = "_daysOverdue">The days the invoice is overdue.</param>
+    /// <returns>The days of the tier; 0 when no tier is reached.</returns>
+    public static Days highestReachedTier(int _daysOverdue)
+    {
+        DYLO_OverdueNotificationTier tier;
+
+        select firstonly TierDays from tier
+            order by TierDays desc
+            where tier.Active == NoYes::Yes
+               && tier.TierDays > 0
+               && tier.TierDays <= _daysOverdue;
+
+        return tier.TierDays;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
