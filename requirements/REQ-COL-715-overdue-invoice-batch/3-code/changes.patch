+        DYLO_OverdueInvoiceNotificationLog log;
+        int64                              allCount;
+        int64                              sentCount;
+        int64                              failedCount;
+
+        select count(RecId) from log;
+        allCount = log.RecId;
+
+        select count(RecId) from log
+            where log.Status == DYLO_OverdueNotificationStatus::Sent;
+        sentCount = log.RecId;
