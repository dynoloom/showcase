diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationEmail.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationEmail.xml
new file mode 100644
index 0000000..8354f16
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationEmail.xml
@@ -0,0 +1,260 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_OverdueInvoiceNotificationEmail</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Builds and sends overdue invoice notification emails and records the result on the notification log.
+/// Shared by the batch job and the resend action.
+/// </summary>
+public final class DYLO_OverdueInvoiceNotificationEmail
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>buildSubject</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Builds the subject of the notification email.
+    /// </summary>
+    /// <param name = "_log">The log line holding the invoice data.</param>
+    /// <returns>The subject.</returns>
+    public static Description255 buildSubject(DYLO_OverdueInvoiceNotificationLog _log)
+    {
+        return strFmt("@DYLOExtensions:OverdueInvNotifEmailSubjectText", _log.InvoiceId, _log.DaysOverdue);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>buildBody</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Builds the plain text body of the notification email.
+    /// </summary>
+    /// <param name = "_log">The log line holding the invoice data.</param>
+    /// <returns>The body.</returns>
+    public static Notes buildBody(DYLO_OverdueInvoiceNotificationLog _log)
+    {
+        const str NewLine = '\n';
+        str body;
+
+        body  = "@DYLOExtensions:OverdueInvNotifBodyGreeting" + NewLine;
+        body += NewLine;
+        body += strFmt("@DYLOExtensions:OverdueInvNotifBodyInvoice", _log.InvoiceId, _log.CustAccount, _log.CustName) + NewLine;
+        body += strFmt("@DYLOExtensions:OverdueInvNotifBodyAmounts",
+                    _log.CurrencyCode,
+                    DYLO_OverdueInvoiceNotificationEmail::formatAmount(_log.InvoiceAmount),
+                    DYLO_OverdueInvoiceNotificationEmail::formatAmount(_log.RemainingAmount)) + NewLine;
+        body += strFmt("@DYLOExtensions:OverdueInvNotifBodyDaysPastDue", _log.DaysOverdue) + NewLine;
+        body += NewLine;
+        body += strFmt("@DYLOExtensions:OverdueInvNotifBodyInvoiceDate", date2StrUsr(_log.InvoiceDate, DateFlags::FormatAll)) + NewLine;
+        body += strFmt("@DYLOExtensions:OverdueInvNotifBodyDueDate", date2StrUsr(_log.DueDate, DateFlags::FormatAll)) + NewLine;
+        body += strFmt("@DYLOExtensions:OverdueInvNotifBodyTier", _log.TierDays) + NewLine;
+        body += "@DYLOExtensions:OverdueInvNotifBodyAction";
+
+        return body;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>formatAmount</Name>
+				<Source><![CDATA[
+    private static str formatAmount(AmountCur _amount)
+    {
+        return num2Str(_amount, 0, 2, 1, 0);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>sendAndLog</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Sends the email stored on a log line and records the result (status, error, attempts) on the line.
+    /// </summary>
+    /// <param name = "_log">The log line to send.</param>
+    /// <returns>true if the email was sent; otherwise, false.</returns>
+    /// <remarks>
+    /// Must be called outside a transaction, so that a failing email provider can be caught and logged.
+    /// </remarks>
+    public static boolean sendAndLog(DYLO_OverdueInvoiceNotificationLog _log)
+    {
+        DYLO_OverdueNotificationParameters  parameters = DYLO_OverdueNotificationParameters::find();
+        SysMailerMessageBuilder             builder;
+        boolean                             sent;
+        int                                 infologStart = infologLine();
+        str                                 clrMessage;
+        str                                 errorText;
+
+        try
+        {
+            builder = new SysMailerMessageBuilder();
+
+            if (parameters.SenderEmail)
+            {
+                builder.setFrom(parameters.SenderEmail);
+            }
+
+            builder.addTo(_log.RecipientEmail)
+                .setSubject(_log.EmailSubject)
+                .setBody(_log.EmailBody, false);
+
+            sent = SysMailerFactory::sendNonInteractive(builder.getMessage());
+        }
+        catch (Exception::CLRError)
+        {
+            sent = false;
+            clrMessage = DYLO_OverdueInvoiceNotificationEmail::lastClrMessage();
+        }
+        catch (Exception::Error)
+        {
+            sent = false;
+        }
+
+        if (!sent)
+        {
+            errorText = DYLO_OverdueInvoiceNotificationEmail::infologTextSince(infologStart);
+
+            if (clrMessage)
+            {
+                errorText = errorText ? errorText + '\n' + clrMessage : clrMessage;
+            }
+
+            if (!errorText)
+            {
+                errorText = "@DYLOExtensions:OverdueInvNotifErrProviderRejected";
+            }
+        }
+
+        DYLO_OverdueInvoiceNotificationEmail::writeResult(_log.RecId, sent, errorText);
+
+        return sent;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>writeResult</Name>
+				<Source><![CDATA[
+    private static void writeResult(RecId _logRecId, boolean _sent, Notes _errorText)
+    {
+        DYLO_OverdueInvoiceNotificationLog log;
+        TransDateTime                      now = DateTimeUtil::utcNow();
+
+        ttsbegin;
+
+        select firstonly forupdate log
+            where log.RecId == _logRecId;
+
+        if (log.RecId)
+        {
+            if (_sent)
+            {
+                log.Status       = DYLO_OverdueNotificationStatus::Sent;
+                log.ErrorText    = '';
+                log.SentDateTime = now;
+            }
+            else
+            {
+                log.Status    = DYLO_OverdueNotificationStatus::Failed;
+                log.ErrorText = _errorText;
+            }
+
+            log.AttemptCount++;
+            log.LastAttemptDateTime = now;
+            log.update();
+        }
+
+        ttscommit;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>infologTextSince</Name>
+				<Source><![CDATA[
+    private static str infologTextSince(int _infologStart)
+    {
+        str text;
+        int line;
+
+        for (line = _infologStart + 1; line <= infologLine(); line++)
+        {
+            text = text ? text + '\n' + infolog.text(line) : infolog.text(line);
+        }
+
+        return text;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>lastClrMessage</Name>
+				<Source><![CDATA[
+    private static str lastClrMessage()
+    {
+        System.Exception clrException = CLRInterop::getLastException();
+        str              message;
+
+        while (clrException)
+        {
+            message      = clrException.get_Message();
+            clrException = clrException.get_InnerException();
+        }
+
+        return message;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>refreshCaller</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Refreshes the notification log form that called an action, including its status counts.
+    /// </summary>
+    /// <param name = "_args">The arguments of the action.</param>
+    /// <param name = "_retainPosition">true to keep the selected record.</param>
+    public static void refreshCaller(Args _args, boolean _retainPosition = true)
+    {
+        Object         callerForm;
+        FormRun        callerFormRun;
+        FormDataSource formDataSource;
+
+        if (!_args || !(_args.caller() is FormRun))
+        {
+            return;
+        }
+
+        callerFormRun = _args.caller();
+
+        if (_args.record() && _args.record().isFormDataSource())
+        {
+            formDataSource = FormDataUtil::getFormDataSource(_args.record());
+        }
+        else
+        {
+            formDataSource = callerFormRun.dataSource(1);
+        }
+
+        if (formDataSource && formDataSource.table() == tableNum(DYLO_OverdueInvoiceNotificationLog))
+        {
+            formDataSource.research(_retainPosition);
+        }
+
+        callerForm = callerFormRun;
+
+        if (formHasMethod(callerForm, identifierStr(updateCounts)))
+        {
+            callerForm.updateCounts();
+        }
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationPurge.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationPurge.xml
new file mode 100644
index 0000000..aff934c
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationPurge.xml
@@ -0,0 +1,59 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_OverdueInvoiceNotificationPurge</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Deletes overdue invoice notification log lines older than the log retention days of the setup.
+/// </summary>
+public final class DYLO_OverdueInvoiceNotificationPurge
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>main</Name>
+				<Source><![CDATA[
+    public static void main(Args _args)
+    {
+        DYLO_OverdueNotificationParameters  parameters = DYLO_OverdueNotificationParameters::find();
+        DYLO_OverdueInvoiceNotificationLog  log;
+        TransDateTime                       cutoffDateTime;
+        int64                               purgeCount;
+
+        if (parameters.LogRetentionDays <= 0)
+        {
+            throw error("@DYLOExtensions:OverdueInvNotifErrLogRetention");
+        }
+
+        cutoffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -parameters.LogRetentionDays);
+
+        if (Box::yesNo(strFmt("@DYLOExtensions:OverdueInvNotifConfirmPurge",
+                DateTimeUtil::applyTimeZoneOffset(cutoffDateTime, DateTimeUtil::getUserPreferredTimeZone())),
+                DialogButton::No) != DialogButton::Yes)
+        {
+            return;
+        }
+
+        select count(RecId) from log
+            where log.CreatedDateTime < cutoffDateTime;
+
+        purgeCount = log.RecId;
+
+        ttsbegin;
+
+        delete_from log
+            where log.CreatedDateTime < cutoffDateTime;
+
+        ttscommit;
+
+        info(strFmt("@DYLOExtensions:OverdueInvNotifPurged", purgeCount));
+
+        DYLO_OverdueInvoiceNotificationEmail::refreshCaller(_args, false);
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationResend.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationResend.xml
new file mode 100644
index 0000000..55951a8
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationResend.xml
@@ -0,0 +1,85 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_OverdueInvoiceNotificationResend</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Resends the overdue invoice notifications selected on the notification log form.
+/// </summary>
+public final class DYLO_OverdueInvoiceNotificationResend
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>main</Name>
+				<Source><![CDATA[
+    public static void main(Args _args)
+    {
+        DYLO_OverdueInvoiceNotificationLog  log;
+        MultiSelectionHelper                selectionHelper;
+        List                                logRecIds = new List(Types::Int64);
+        ListEnumerator                      enumerator;
+        boolean                             hasSentLine;
+        int                                 sentCount;
+        int                                 failedCount;
+
+        if (!_args || !_args.record() || _args.record().TableId != tableNum(DYLO_OverdueInvoiceNotificationLog))
+        {
+            throw error(Error::missingRecord(funcName()));
+        }
+
+        if (_args.record().isFormDataSource())
+        {
+            selectionHelper = MultiSelectionHelper::construct();
+            selectionHelper.parmDatasource(FormDataUtil::getFormDataSource(_args.record()));
+
+            for (log = selectionHelper.getFirst(); log; log = selectionHelper.getNext())
+            {
+                logRecIds.addEnd(log.RecId);
+                hasSentLine = hasSentLine || log.Status == DYLO_OverdueNotificationStatus::Sent;
+            }
+        }
+        else
+        {
+            log = _args.record();
+            logRecIds.addEnd(log.RecId);
+            hasSentLine = log.Status == DYLO_OverdueNotificationStatus::Sent;
+        }
+
+        if (hasSentLine
+            && Box::yesNo("@DYLOExtensions:OverdueInvNotifConfirmResendSent", DialogButton::No) != DialogButton::Yes)
+        {
+            return;
+        }
+
+        enumerator = logRecIds.getEnumerator();
+
+        while (enumerator.moveNext())
+        {
+            select firstonly log
+                where log.RecId == enumerator.current();
+
+            if (log.RecId)
+            {
+                if (DYLO_OverdueInvoiceNotificationEmail::sendAndLog(log))
+                {
+                    sentCount++;
+                }
+                else
+                {
+                    failedCount++;
+                }
+            }
+        }
+
+        info(strFmt("@DYLOExtensions:OverdueInvNotifResendResult", sentCount, failedCount));
+
+        DYLO_OverdueInvoiceNotificationEmail::refreshCaller(_args);
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationService.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationService.xml
new file mode 100644
index 0000000..34185fd
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_OverdueInvoiceNotificationService.xml
@@ -0,0 +1,207 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_OverdueInvoiceNotificationService</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Service of the overdue invoice notification batch job. Finds the open customer invoices that reached an
+/// overdue tier and sends one notification per invoice and tier.
+/// </summary>
+public class DYLO_OverdueInvoiceNotificationService extends SysOperationServiceBase
+{
+    TransDate   runDate;
+    Email       recipientEmail;
+    int         checkedCount;
+    int         sentCount;
+    int         failedCount;
+    int         skippedCount;
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>process</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Runs the overdue invoice notification job.
+    /// </summary>
+    /// <param name = "_contract">The parameters of the job.</param>
+    public void process(DYLO_OverdueInvoiceNotificationContract _contract)
+    {
+        CustTransOpen       custTransOpen;
+        CustTrans           custTrans;
+        CustInvoiceJour     custInvoiceJour;
+        CustGroupId         custGroupId = _contract.parmCustGroupId();
+        TransDate           cutoffDate;
+
+        if (!_contract.validate())
+        {
+            throw Exception::Error;
+        }
+
+        if (!DYLO_OverdueNotificationTier::hasActiveTier())
+        {
+            throw error("@DYLOExtensions:OverdueInvNotifErrNoTiers");
+        }
+
+        runDate        = DateTimeUtil::getSystemDate(DateTimeUtil::getCompanyTimeZone());
+        cutoffDate     = runDate - _contract.parmGracePeriodDays();
+        recipientEmail = _contract.parmRecipientEmail();
+
+        // One row per open invoice transaction, with the earliest due date of its open lines past the cut-off.
+        while select RefRecId, minof(DueDate) from custTransOpen
+            group by custTransOpen.RefRecId
+            where custTransOpen.DueDate < cutoffDate
+               && custTransOpen.DueDate != dateNull()
+            exists join custTrans
+                where custTrans.RecId     == custTransOpen.RefRecId
+                   && custTrans.AmountCur > 0
+            exists join custInvoiceJour
+                where custInvoiceJour.InvoiceId      == custTrans.Invoice
+                   && custInvoiceJour.InvoiceAccount == custTrans.AccountNum
+                   && custInvoiceJour.InvoiceDate    == custTrans.TransDate
+                   && custInvoiceJour.LedgerVoucher  == custTrans.Voucher
+        {
+            this.processInvoice(custTransOpen.RefRecId, custTransOpen.DueDate, custGroupId);
+        }
+
+        info(strFmt("@DYLOExtensions:OverdueInvNotifSummaryChecked", checkedCount));
+        info(strFmt("@DYLOExtensions:OverdueInvNotifSummarySent", sentCount));
+        info(strFmt("@DYLOExtensions:OverdueInvNotifSummaryFailed", failedCount));
+        info(strFmt("@DYLOExtensions:OverdueInvNotifSummarySkipped", skippedCount));
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>processInvoice</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Checks one open invoice and sends its notification when it reached a tier that was not notified yet.
+    /// </summary>
+    /// <param name = "_custTransRecId">The record ID of the customer transaction of the invoice.</param>
+    /// <param name = "_dueDate">The earliest open due date of the invoice.</param>
+    /// <param name = "_custGroupId">The customer group filter; empty for all customers.</param>
+    private void processInvoice(RefRecId _custTransRecId, DueDate _dueDate, CustGroupId _custGroupId)
+    {
+        CustTrans                           custTrans;
+        CustInvoiceJour                     custInvoiceJour;
+        DYLO_OverdueInvoiceNotificationLog  log;
+        int                                 daysOverdue;
+        Days                                tierDays;
+
+        select firstonly custTrans
+            where custTrans.RecId == _custTransRecId;
+
+        select firstonly custInvoiceJour
+            where custInvoiceJour.InvoiceId      == custTrans.Invoice
+               && custInvoiceJour.InvoiceAccount == custTrans.AccountNum
+               && custInvoiceJour.InvoiceDate    == custTrans.TransDate
+               && custInvoiceJour.LedgerVoucher  == custTrans.Voucher;
+
+        if (!custInvoiceJour.RecId)
+        {
+            return;
+        }
+
+        if (_custGroupId && CustTable::find(custInvoiceJour.InvoiceAccount).CustGroup != _custGroupId)
+        {
+            return;
+        }
+
+        checkedCount++;
+
+        daysOverdue = runDate - _dueDate;
+        tierDays    = DYLO_OverdueNotificationTier::highestReachedTier(daysOverdue);
+
+        if (!tierDays)
+        {
+            skippedCount++;
+            return;
+        }
+
+        try
+        {
+            log = DYLO_OverdueInvoiceNotificationLog::findByInvoiceTier(custInvoiceJour.RecId, tierDays);
+
+            if (log.RecId && log.Status == DYLO_OverdueNotificationStatus::Sent)
+            {
+                skippedCount++;
+                return;
+            }
+
+            if (!log.RecId)
+            {
+                log = this.createLog(custTrans, custInvoiceJour, _dueDate, daysOverdue, tierDays);
+            }
+
+            if (DYLO_OverdueInvoiceNotificationEmail::sendAndLog(log))
+            {
+                sentCount++;
+            }
+            else
+            {
+                failedCount++;
+            }
+        }
+        catch (Exception::Error)
+        {
+            failedCount++;
+            error(strFmt("@DYLOExtensions:OverdueInvNotifInvoiceFailed", custInvoiceJour.InvoiceId));
+        }
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>createLog</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Creates the notification log line of an invoice and tier, with the email that is sent.
+    /// </summary>
+    /// <param name = "_custTrans">The customer transaction of the invoice.</param>
+    /// <param name = "_custInvoiceJour">The customer invoice journal.</param>
+    /// <param name = "_dueDate">The earliest open due date.</param>
+    /// <param name = "_daysOverdue">The days the invoice is overdue.</param>
+    /// <param name = "_tierDays">The tier reached.</param>
+    /// <returns>The inserted log line.</returns>
+    private DYLO_OverdueInvoiceNotificationLog createLog(
+        CustTrans       _custTrans,
+        CustInvoiceJour _custInvoiceJour,
+        DueDate         _dueDate,
+        int             _daysOverdue,
+        Days            _tierDays)
+    {
+        DYLO_OverdueInvoiceNotificationLog  log;
+        CustTransOpen                       custTransOpen;
+
+        select sum(AmountCur) from custTransOpen
+            where custTransOpen.RefRecId == _custTrans.RecId;
+
+        log.CustInvoiceJourRecId = _custInvoiceJour.RecId;
+        log.InvoiceId            = _custInvoiceJour.InvoiceId;
+        log.InvoiceDate          = _custInvoiceJour.InvoiceDate;
+        log.CustAccount          = _custInvoiceJour.InvoiceAccount;
+        log.CustName             = CustTable::find(_custInvoiceJour.InvoiceAccount).name();
+        log.DueDate              = _dueDate;
+        log.DaysOverdue          = _daysOverdue;
+        log.TierDays             = _tierDays;
+        log.InvoiceAmount        = _custInvoiceJour.InvoiceAmount;
+        log.RemainingAmount      = custTransOpen.AmountCur;
+        log.CurrencyCode         = _custInvoiceJour.CurrencyCode;
+        log.RecipientEmail       = recipientEmail;
+        log.EmailSubject         = DYLO_OverdueInvoiceNotificationEmail::buildSubject(log);
+        log.EmailBody            = DYLO_OverdueInvoiceNotificationEmail::buildBody(log);
+        log.Status               = DYLO_OverdueNotificationStatus::Failed;
+
+        ttsbegin;
+        log.insert();
+        ttscommit;
+
+        return log;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
