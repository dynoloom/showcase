diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_CustCustomerV3Entity_Extension.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_CustCustomerV3Entity_Extension.xml
new file mode 100644
index 0000000..6dbf4f8
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_CustCustomerV3Entity_Extension.xml
@@ -0,0 +1,71 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_CustCustomerV3Entity_Extension</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Extends the Customers V3 data entity with the loyalty tier: the text field <c>LoyaltyTier</c>
+/// is converted to <c>CustTable.DYLO_LoyaltyTier</c> on write and filled from it on read.
+/// </summary>
+[ExtensionOf(tableStr(CustCustomerV3Entity))]
+final class DYLO_CustCustomerV3Entity_Extension
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>mapEntityToDataSource</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Writes the loyalty tier to the customer when the caller sent it.
+    /// An empty value gives Standard; an unknown value throws an error before anything is saved.
+    /// </summary>
+    /// <param name = "_entityCtx">The entity runtime context.</param>
+    /// <param name = "_dataSourceCtx">The data source runtime context.</param>
+    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
+    {
+        if (_dataSourceCtx.name() == dataEntityDataSourceStr(CustCustomerV3Entity, CustTable)
+            && this.fieldState(fieldNum(CustCustomerV3Entity, LoyaltyTier)) != FieldState::NotSet)
+        {
+            DYLO_LoyaltyTier tier = DYLO_CustLoyaltyTierConverter::fromText(this.LoyaltyTier);
+            CustTable custTable = _dataSourceCtx.getBuffer();
+            custTable.DYLO_LoyaltyTier = tier;
+        }
+
+        next mapEntityToDataSource(_entityCtx, _dataSourceCtx);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>postLoad</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Fills the loyalty tier text from the customer.
+    /// </summary>
+    public void postLoad()
+    {
+        next postLoad();
+
+        DYLO_LoyaltyTier tier = DYLO_LoyaltyTier::Standard;
+
+        if (this.CustomerAccount)
+        {
+            changecompany(this.DataAreaId)
+            {
+                CustTable custTable = CustTable::find(this.CustomerAccount);
+                if (custTable.RecId)
+                {
+                    tier = custTable.DYLO_LoyaltyTier;
+                }
+            }
+        }
+
+        this.LoyaltyTier = DYLO_CustLoyaltyTierConverter::toText(tier);
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_CustLoyaltyTierConverter.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_CustLoyaltyTierConverter.xml
new file mode 100644
index 0000000..6403d82
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_CustLoyaltyTierConverter.xml
@@ -0,0 +1,69 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_CustLoyaltyTierConverter</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Converts the customer loyalty tier between its text form, used by the Customers V3 data entity,
+/// and the <c>DYLO_LoyaltyTier</c> enum stored on <c>CustTable</c>.
+/// </summary>
+public final class DYLO_CustLoyaltyTierConverter
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>fromText</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Converts a loyalty tier text to the enum value. Empty or blank text gives Standard.
+    /// The text is matched, ignoring case and surrounding spaces, to the enum element names and labels.
+    /// </summary>
+    /// <param name = "_text">The loyalty tier text.</param>
+    /// <returns>The loyalty tier.</returns>
+    /// <exception>An error is thrown when the text is not a known loyalty tier.</exception>
+    public static DYLO_LoyaltyTier fromText(DYLO_LoyaltyTierText _text)
+    {
+        str value = strLRTrim(_text);
+
+        if (value == '')
+        {
+            return DYLO_LoyaltyTier::Standard;
+        }
+
+        str valueUpr = strUpr(value);
+        DictEnum dictEnum = new DictEnum(enumNum(DYLO_LoyaltyTier));
+
+        for (int i = 0; i < dictEnum.values(); i++)
+        {
+            if (valueUpr == strUpr(dictEnum.index2Symbol(i))
+                || valueUpr == strUpr(dictEnum.index2Label(i)))
+            {
+                DYLO_LoyaltyTier tier = dictEnum.index2Value(i);
+                return tier;
+            }
+        }
+
+        throw error(strFmt("@DYLOExtensions:CustCommPrefLoyaltyTierInvalid", value));
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>toText</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Converts a loyalty tier to its text: Standard, Silver, Gold or Platinum.
+    /// </summary>
+    /// <param name = "_tier">The loyalty tier.</param>
+    /// <returns>The element name of the loyalty tier.</returns>
+    public static DYLO_LoyaltyTierText toText(DYLO_LoyaltyTier _tier)
+    {
+        return enum2Symbol(enumNum(DYLO_LoyaltyTier), enum2int(_tier));
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
