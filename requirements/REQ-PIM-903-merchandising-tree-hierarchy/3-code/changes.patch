diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxTable/DYLO_MerchHierarchyNode.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxTable/DYLO_MerchHierarchyNode.xml
new file mode 100644
index 0000000..a4f70cd
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxTable/DYLO_MerchHierarchyNode.xml
@@ -0,0 +1,675 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxTable xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_MerchHierarchyNode</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// A node of the merchandising hierarchy (REQ-PIM-903). Self-referencing via <c>ParentNode</c>; kept per legal entity.
+/// </summary>
+public class DYLO_MerchHierarchyNode extends common
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>initValue</Name>
+				<Source><![CDATA[
+    public void initValue()
+    {
+        super();
+
+        this.Active = NoYes::Yes;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>find</Name>
+				<Source><![CDATA[
+    public static DYLO_MerchHierarchyNode find(RecId _recId, boolean _forUpdate = false)
+    {
+        DYLO_MerchHierarchyNode node;
+
+        if (_recId)
+        {
+            node.selectForUpdate(_forUpdate);
+
+            select firstonly node
+                where node.RecId == _recId;
+        }
+
+        return node;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>findByNodeId</Name>
+				<Source><![CDATA[
+    public static DYLO_MerchHierarchyNode findByNodeId(DYLO_MerchNodeId _nodeId, boolean _forUpdate = false)
+    {
+        DYLO_MerchHierarchyNode node;
+
+        if (_nodeId)
+        {
+            node.selectForUpdate(_forUpdate);
+
+            select firstonly node
+                where node.NodeId == _nodeId;
+        }
+
+        return node;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>findRoot</Name>
+				<Source><![CDATA[
+    public static DYLO_MerchHierarchyNode findRoot(boolean _forUpdate = false)
+    {
+        DYLO_MerchHierarchyNode node;
+
+        node.selectForUpdate(_forUpdate);
+
+        select firstonly node
+            where node.ParentNode == 0;
+
+        return node;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>exist</Name>
+				<Source><![CDATA[
+    public static boolean exist(DYLO_MerchNodeId _nodeId)
+    {
+        return _nodeId
+            && (select firstonly RecId from DYLO_MerchHierarchyNode
+                    where DYLO_MerchHierarchyNode.NodeId == _nodeId).RecId != 0;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>isRoot</Name>
+				<Source><![CDATA[
+    public boolean isRoot()
+    {
+        return this.RecId != 0 && this.ParentNode == 0;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>hasChildren</Name>
+				<Source><![CDATA[
+    public boolean hasChildren()
+    {
+        DYLO_MerchHierarchyNode child;
+
+        if (!this.RecId)
+        {
+            return false;
+        }
+
+        select firstonly RecId from child
+            where child.ParentNode == this.RecId;
+
+        return child.RecId != 0;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>hasProducts</Name>
+				<Source><![CDATA[
+    public boolean hasProducts()
+    {
+        DYLO_MerchHierarchyProduct product;
+
+        if (!this.RecId)
+        {
+            return false;
+        }
+
+        select firstonly RecId from product
+            where product.Node == this.RecId;
+
+        return product.RecId != 0;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>isLeaf</Name>
+				<Source><![CDATA[
+    public boolean isLeaf()
+    {
+        return !this.hasChildren();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>parentNode</Name>
+				<Source><![CDATA[
+    public DYLO_MerchHierarchyNode parentNode()
+    {
+        return DYLO_MerchHierarchyNode::find(this.ParentNode);
+    }
+
+]]></Source>
