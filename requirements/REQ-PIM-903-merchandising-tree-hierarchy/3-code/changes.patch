+/// <summary>
+/// The assignment of a released product to one leaf node of the merchandising hierarchy (REQ-PIM-903).
+/// One node per product per legal entity.
+/// </summary>
+public class DYLO_MerchHierarchyProduct extends common
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>findByItemId</Name>
+				<Source><![CDATA[
+    public static DYLO_MerchHierarchyProduct findByItemId(ItemId _itemId, boolean _forUpdate = false)
+    {
+        DYLO_MerchHierarchyProduct product;
+
+        if (_itemId)
+        {
+            product.selectForUpdate(_forUpdate);
+
+            select firstonly product
+                where product.ItemId == _itemId;
+        }
+
+        return product;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>validateWrite</Name>
+				<Source><![CDATA[
+    public boolean validateWrite()
+    {
+        boolean                     ret = super();
+        DYLO_MerchHierarchyNode     node;
+        DYLO_MerchHierarchyProduct  other;
+
+        if (ret)
+        {
+            node = DYLO_MerchHierarchyNode::find(this.Node);
+
+            if (!node.RecId)
+            {
+                ret = checkFailed("@DYLOExtensions:MerchHierNodeMissing");
+            }
+            else
+            {
+                if (!node.Active)
+                {
+                    ret = checkFailed(strFmt("@DYLOExtensions:MerchHierNodeInactive", node.NodeId));
+                }
+
+                if (!node.isLeaf())
+                {
+                    ret = checkFailed(strFmt("@DYLOExtensions:MerchHierNotLeaf", node.NodeId));
+                }
+            }
+
+            select firstonly Node, RecId from other
+                where other.ItemId == this.ItemId
+                   && other.RecId  != this.RecId;
+
+            if (other.RecId)
+            {
+                ret = checkFailed(strFmt("@DYLOExtensions:MerchHierAlreadyAssigned",
+                    this.ItemId,
+                    DYLO_MerchHierarchyNode::find(other.Node).nodeDisplay()));
+            }
+        }
+
+        return ret;
+    }
+
+]]></Source>
