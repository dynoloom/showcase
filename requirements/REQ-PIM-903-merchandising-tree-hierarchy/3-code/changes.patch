diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxForm/DYLO_MerchHierarchy.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxForm/DYLO_MerchHierarchy.xml
new file mode 100644
index 0000000..3e6d8ab
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxForm/DYLO_MerchHierarchy.xml
@@ -0,0 +1,840 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxForm xmlns:i="http://www.w3.org/2001/XMLSchema-instance" xmlns="Microsoft.Dynamics.AX.Metadata.V6">
+	<Name>DYLO_MerchHierarchy</Name>
+	<SourceCode>
+		<Methods xmlns="">
+			<Method>
+				<Name>classDeclaration</Name>
+				<Source><![CDATA[
+/// <summary>
+/// Merchandising hierarchy (REQ-PIM-903): the hierarchy as a tree, the selected node's details
+/// and inherited margin rules, and the released products assigned to the node and its sub-nodes.
+/// </summary>
+[Form]
+public class DYLO_MerchHierarchy extends FormRun
+{
+    DYLO_MerchHierarchyTreeDatasource treeHelper;
+}
+]]></Source>
+			</Method>
+			<Method>
+				<Name>init</Name>
+				<Source><![CDATA[
+    public void init()
+    {
+        DYLO_MerchHierarchyManager::createRootIfMissing();
+
+        super();
+
+        treeHelper = DYLO_MerchHierarchyTreeDatasource::construct(DYLO_MerchHierarchyNode_ds, HierarchyTree);
+        treeHelper.initTree();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>updateDesign</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Sets the captions and enables the buttons for the selected node.
+    /// </summary>
+    public void updateDesign()
+    {
+        DYLO_MerchHierarchyNode node        = DYLO_MerchHierarchyNode;
+        boolean                 hasNode     = node.RecId != 0;
+        boolean                 isRoot      = node.isRoot();
+        boolean                 hasProducts = node.hasProducts();
+        boolean                 isLeaf      = node.isLeaf();
+
+        NewChildNode.enabled(hasNode && node.Active && !hasProducts);
+        MoveUp.enabled(hasNode && !isRoot && DYLO_MerchHierarchyManager::findSibling(node, true).RecId != 0);
+        MoveDown.enabled(hasNode && !isRoot && DYLO_MerchHierarchyManager::findSibling(node, false).RecId != 0);
+        ReparentNode.enabled(hasNode && !isRoot);
+        DeleteNode.enabled(hasNode && !isRoot);
+        AddProduct.enabled(hasNode && node.Active && isLeaf);
+        RemoveProduct.enabled(DYLO_MerchHierarchyProduct.RecId != 0);
+
+        DetailsGroup.caption(strFmt("@DYLOExtensions:MerchHierDetailsCaption", node.nodeDisplay()));
+        ProductsGroup.caption(strFmt("@DYLOExtensions:MerchHierProductsCaption",
+            DYLO_MerchHierarchyManager::rollupProductCount(node.RecId)));
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>afterReparent</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Called by the re-parent dialog: rebuilds the tree and selects the moved node.
+    /// </summary>
+    public void afterReparent(RecId _nodeRecId)
+    {
+        treeHelper.initTree(_nodeRecId);
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+		<DataSources xmlns="">
+			<DataSource>
+				<Name>DYLO_MerchHierarchyNode</Name>
+				<Methods>
+					<Method>
+						<Name>active</Name>
+						<Source><![CDATA[
+        public int active()
+        {
+            int ret = super();
+
+            DYLO_MerchHierarchyProduct_ds.executeQuery();
+            element.updateDesign();
+
+            return ret;
+        }
+
+]]></Source>
+					</Method>
+					<Method>
+						<Name>written</Name>
+						<Source><![CDATA[
+        public void written()
+        {
+            super();
+
+            // The effective margin, level and inheritance are calculated on save.
+            this.reread();
+            this.refresh();
+
+            if (treeHelper)
+            {
+                treeHelper.refreshSelectedText();
+            }
+
+            DYLO_MerchHierarchyProduct_ds.executeQuery();
+            element.updateDesign();
+        }
+
+]]></Source>
+					</Method>
+				</Methods>
+				<Fields />
+			</DataSource>
+			<DataSource>
+				<Name>DYLO_MerchHierarchyProduct</Name>
+				<Methods>
+					<Method>
+						<Name>initValue</Name>
+						<Source><![CDATA[
+        public void initValue()
+        {
+            super();
+
+            DYLO_MerchHierarchyProduct.Node = DYLO_MerchHierarchyNode.RecId;
+        }
+
+]]></Source>
+					</Method>
+					<Method>
+						<Name>executeQuery</Name>
+						<Source><![CDATA[
+        /// <summary>
+        /// Shows the products of the selected node and all its sub-nodes (roll-up).
+        /// </summary>
+        public void executeQuery()
+        {
+            QueryBuildDataSource    qbds = this.query().dataSourceTable(tableNum(DYLO_MerchHierarchyProduct));
+            SetEnumerator           enumerator;
+            RecId                   nodeRecId;
+
+            qbds.clearRanges();
+
+            if (DYLO_MerchHierarchyNode.RecId)
+            {
+                enumerator = DYLO_MerchHierarchyManager::subtreeNodeRecIds(DYLO_MerchHierarchyNode.RecId).getEnumerator();
+
+                while (enumerator.moveNext())
+                {
+                    nodeRecId = enumerator.current();
+                    qbds.addRange(fieldNum(DYLO_MerchHierarchyProduct, Node)).value(queryValue(nodeRecId));
+                }
+            }
+            else
+            {
+                qbds.addRange(fieldNum(DYLO_MerchHierarchyProduct, Node)).value(queryValue(0));
+            }
+
+            super();
+        }
+
+]]></Source>
+					</Method>
+					<Method>
+						<Name>active</Name>
+						<Source><![CDATA[
+        public int active()
+        {
+            int ret = super();
+
+            // The item can be chosen on a new assignment only.
+            this.object(fieldNum(DYLO_MerchHierarchyProduct, ItemId)).allowEdit(!DYLO_MerchHierarchyProduct.RecId);
+            RemoveProduct.enabled(DYLO_MerchHierarchyProduct.RecId != 0);
+
+            return ret;
+        }
+
+]]></Source>
+					</Method>
+					<Method>
+						<Name>written</Name>
+						<Source><![CDATA[
+        public void written()
+        {
+            super();
+
+            element.updateDesign();
+        }
+
+]]></Source>
+					</Method>
+					<Method>
+						<Name>delete</Name>
+						<Source><![CDATA[
+        public void delete()
+        {
+            super();
+
+            element.updateDesign();
+        }
+
+]]></Source>
+					</Method>
+				</Methods>
+				<Fields />
+			</DataSource>
+		</DataSources>
+		<DataControls xmlns="">
+			<Control>
+				<Name>NewChildNode</Name>
+				<Type>Button</Type>
+				<Methods>
+					<Method>
+						<Name>clicked</Name>
+						<Source><![CDATA[
+        public void clicked()
+        {
+            super();
+
+            if (treeHelper)
+            {
+                treeHelper.create();
+            }
+        }
+
+]]></Source>
+					</Method>
+				</Methods>
+			</Control>
+			<Control>
+				<Name>MoveUp</Name>
+				<Type>Button</Type>
+				<Methods>
+					<Method>
+						<Name>clicked</Name>
+						<Source><![CDATA[
+        public void clicked()
+        {
+            int                     idx = HierarchyTree.getSelection();
+            DYLO_MerchHierarchyNode node;
+
+            super();
+
+            if (!treeHelper || !DYLO_MerchHierarchyNode_ds.leaveRecord())
+            {
+                return;
+            }
+
+            node = treeHelper.selectedNode();
+
+            if (DYLO_MerchHierarchyManager::moveUp(node))
+            {
+                treeHelper.refreshSubtree(HierarchyTree.getParent(idx), node.RecId);
+            }
+        }
+
+]]></Source>
+					</Method>
+				</Methods>
+			</Control>
+			<Control>
+				<Name>MoveDown</Name>
+				<Type>Button</Type>
+				<Methods>
+					<Method>
