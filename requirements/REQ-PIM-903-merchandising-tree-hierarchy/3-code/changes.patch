+			<Method>
+				<Name>initFromParent</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Initializes a new child node from its parent node.
+    /// </summary>
+    public void initFromParent(DYLO_MerchHierarchyNode _parent)
+    {
+        this.ParentNode                 = _parent.RecId;
+        this.HierarchyLevel             = _parent.HierarchyLevel + 1;
+        this.SortOrder                  = DYLO_MerchHierarchyManager::nextSortOrder(_parent.RecId);
+        this.EffectiveMinGrossMarginPct = _parent.EffectiveMinGrossMarginPct;
+        this.InheritedFromNode          = _parent.InheritedFromNode;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>calcFromParent</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Calculates the level and the effective minimum gross margin from the parent node.
+    /// A node's own value (other than 0) wins; 0 inherits the nearest parent's effective value.
+    /// </summary>
+    public void calcFromParent()
+    {
+        DYLO_MerchHierarchyNode parent = this.parentNode();
+
+        if (parent.RecId)
+        {
+            this.HierarchyLevel = parent.HierarchyLevel + 1;
+
+            if (this.MinGrossMarginPct != 0)
+            {
+                this.EffectiveMinGrossMarginPct = this.MinGrossMarginPct;
+                this.InheritedFromNode          = this.RecId;
+            }
+            else
+            {
+                this.EffectiveMinGrossMarginPct = parent.EffectiveMinGrossMarginPct;
+                this.InheritedFromNode          = parent.InheritedFromNode;
+            }
+        }
+        else
+        {
+            this.HierarchyLevel             = 1;
+            this.EffectiveMinGrossMarginPct = this.MinGrossMarginPct;
+            this.InheritedFromNode          = this.RecId;
+        }
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>insert</Name>
+				<Source><![CDATA[
+    public void insert()
+    {
+        ttsbegin;
+
+        this.calcFromParent();
+
+        super();
+
+        if (!this.InheritedFromNode)
+        {
+            // The node's own value is effective: point to the node itself now that its RecId is known.
+            this.selectForUpdate(true);
+            this.InheritedFromNode = this.RecId;
+            this.doUpdate();
+        }
+
+        ttscommit;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>update</Name>
+				<Source><![CDATA[
+    public void update()
+    {
+        DYLO_MerchHierarchyNode orig = this.orig();
+        boolean                 recalcSubtree;
+
+        ttsbegin;
+
+        this.calcFromParent();
+
+        recalcSubtree = orig.ParentNode                 != this.ParentNode
+                     || orig.MinGrossMarginPct          != this.MinGrossMarginPct
+                     || orig.EffectiveMinGrossMarginPct != this.EffectiveMinGrossMarginPct
+                     || orig.InheritedFromNode          != this.InheritedFromNode
+                     || orig.HierarchyLevel             != this.HierarchyLevel;
+
+        super();
+
+        if (recalcSubtree)
+        {
+            DYLO_MerchHierarchyManager::recalcSubtree(this);
+        }
+
+        ttscommit;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>validateWrite</Name>
+				<Source><![CDATA[
+    public boolean validateWrite()
+    {
+        boolean                 ret = super();
+        DYLO_MerchHierarchyNode parent;
+        DYLO_MerchHierarchyNode otherRoot;
+
+        if (ret)
+        {
+            if (!this.ParentNode)
+            {
+                select firstonly RecId from otherRoot
+                    where otherRoot.ParentNode == 0
+                       && otherRoot.RecId      != this.RecId;
+
+                if (otherRoot.RecId)
+                {
+                    ret = checkFailed("@DYLOExtensions:MerchHierOnlyOneRoot");
+                }
+            }
+            else
+            {
+                parent = DYLO_MerchHierarchyNode::find(this.ParentNode);
+
+                if (!parent.RecId || parent.RecId == this.RecId)
+                {
+                    ret = checkFailed("@DYLOExtensions:MerchHierParentInvalid");
+                }
+                else if (!this.RecId)
+                {
+                    if (parent.hasProducts())
+                    {
+                        ret = checkFailed(strFmt("@DYLOExtensions:MerchHierParentHasProducts", parent.NodeId));
+                    }
+
+                    if (!parent.Active)
+                    {
+                        ret = checkFailed(strFmt("@DYLOExtensions:MerchHierParentInactive", parent.NodeId));
+                    }
+                }
+                else if (this.ParentNode != this.orig().ParentNode)
+                {
+                    ret = DYLO_MerchHierarchyManager::validateNewParent(this, parent) && ret;
+                }
+            }
+
+            if (this.MinGrossMarginPct < 0 || this.MinGrossMarginPct > 100)
+            {
+                ret = checkFailed("@DYLOExtensions:MerchHierMarginRange");
+            }
+        }
+
+        return ret;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>validateDelete</Name>
+				<Source><![CDATA[
+    public boolean validateDelete()
+    {
+        boolean ret = super();
+
+        if (ret)
+        {
+            if (!this.ParentNode)
+            {
+                ret = checkFailed("@DYLOExtensions:MerchHierRootNoDelete");
+            }
+
+            if (this.hasChildren())
+            {
+                ret = checkFailed(strFmt("@DYLOExtensions:MerchHierHasChildren", this.NodeId));
+            }
+
+            if (this.hasProducts())
+            {
+                ret = checkFailed(strFmt("@DYLOExtensions:MerchHierHasProducts", this.NodeId));
+            }
+        }
+
+        return ret;
+    }
+
+]]></Source>
+			</Method>
