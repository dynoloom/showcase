diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_MerchHierarchyManager.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_MerchHierarchyManager.xml
