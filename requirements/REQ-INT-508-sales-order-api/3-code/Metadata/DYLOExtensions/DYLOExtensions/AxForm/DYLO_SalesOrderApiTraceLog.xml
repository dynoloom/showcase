			<Method>
				<Name>applyFilters</Name>
				<Source><![CDATA[
    /// <summary>
    /// Applies the text filter and the status filter of the filter bar to the query.
    /// </summary>
    public void applyFilters()
    {
        QueryBuildDataSource    qbds        = DYLO_SalesOrderApiTrace_ds.queryBuildDataSource();
        QueryBuildRange         textRange   = SysQuery::findOrCreateRange(qbds, fieldNum(DYLO_SalesOrderApiTrace, RecId));
        QueryBuildRange         statusRange = SysQuery::findOrCreateRange(qbds, fieldNum(DYLO_SalesOrderApiTrace, Status));
        str                     searchText  = strRem(FilterText.valueStr(), '"()\\\'');

        if (searchText)
        {
            textRange.value(strFmt('((%1.%2 like "*%4*") || (%1.%3 like "*%4*"))',
                qbds.name(),
                fieldStr(DYLO_SalesOrderApiTrace, CorrelationId),
                fieldStr(DYLO_SalesOrderApiTrace, ExternalOrderRef),
                searchText));
        }
        else
        {
            textRange.value(SysQuery::valueUnlimited());
        }

        switch (StatusFilter.selection())
        {
            case DYLO_SalesOrderApiStatusFilter::Success:
                statusRange.value(queryValue(DYLO_SalesOrderApiStatus::Success));
                break;

            case DYLO_SalesOrderApiStatusFilter::Failed:
                statusRange.value(queryValue(DYLO_SalesOrderApiStatus::Failed));
                break;

            case DYLO_SalesOrderApiStatusFilter::Reprocessed:
                statusRange.value(queryValue(DYLO_SalesOrderApiStatus::Reprocessed));
                break;

            default:
                statusRange.value(SysQuery::valueUnlimited());
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateCounts</Name>
				<Source><![CDATA[
    /// <summary>
    /// Shows the number of trace records of the current legal entity per status.
    /// </summary>
    public void updateCounts()
    {
        DYLO_SalesOrderApiTrace trace;
        int64                   countAll;
        int64                   countSuccess;
        int64                   countFailed;
        int64                   countReprocessed;

        select count(RecId) from trace;
        countAll = trace.RecId;

        select count(RecId) from trace
            where trace.Status == DYLO_SalesOrderApiStatus::Success;
        countSuccess = trace.RecId;

        select count(RecId) from trace
            where trace.Status == DYLO_SalesOrderApiStatus::Failed;
        countFailed = trace.RecId;

        select count(RecId) from trace
            where trace.Status == DYLO_SalesOrderApiStatus::Reprocessed;
        countReprocessed = trace.RecId;

        CountsText.text(strFmt("@DYLOExtensions:SOApiCounts", countAll, countSuccess, countFailed, countReprocessed));
    }

]]></Source>
