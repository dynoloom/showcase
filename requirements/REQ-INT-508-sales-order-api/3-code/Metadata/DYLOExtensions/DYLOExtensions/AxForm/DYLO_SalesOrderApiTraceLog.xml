					<Method>
						<Name>displayOption</Name>
						<Source><![CDATA[
        public void displayOption(Common _record, FormRowDisplayOption _options)
        {
            DYLO_SalesOrderApiTrace trace = _record;

            switch (trace.Status)
            {
                case DYLO_SalesOrderApiStatus::Success:
                    _options.backColor(WinAPI::RGB2int(220, 245, 227));  // #DCF5E3
                    break;

                case DYLO_SalesOrderApiStatus::Failed:
                    _options.backColor(WinAPI::RGB2int(253, 226, 226));  // #FDE2E2
                    break;

                case DYLO_SalesOrderApiStatus::Reprocessed:
                    _options.backColor(WinAPI::RGB2int(255, 244, 206));  // #FFF4CE
                    break;
            }

            _options.affectedElementsByControl(Grid_Status.id());

            super(_record, _options);
        }

]]></Source>
