diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_JsonFormatter.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_JsonFormatter.xml
new file mode 100644
index 0000000..8cec483
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_JsonFormatter.xml
@@ -0,0 +1,149 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_JsonFormatter</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Indents a JSON text for display ("pretty print"), without external libraries.
+/// </summary>
+public class DYLO_JsonFormatter
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>format</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Formats a JSON text: 2 spaces of indentation per level, a line break after each comma and
+    /// around brackets, a space after each colon. Text inside strings, escapes included, is kept as is.
+    /// </summary>
+    /// <param name = "_json">The JSON text.</param>
+    /// <returns>The formatted JSON text.</returns>
+    public static str format(str _json)
+    {
+        System.Text.StringBuilder   builder = new System.Text.StringBuilder();
+        int                         length  = strLen(_json);
+        int                         indent;
+        int                         pos;
+        int                         nextPos;
+        boolean                     inString;
+        boolean                     escaped;
+        str                         c;
+        str                         nextChar;
+
+        for (pos = 1; pos <= length; pos++)
+        {
+            c = subStr(_json, pos, 1);
+
+            if (inString)
+            {
+                builder.Append(c);
+
+                if (escaped)
+                {
+                    escaped = false;
+                }
+                else if (c == '\\')
+                {
+                    escaped = true;
+                }
+                else if (c == '"')
+                {
+                    inString = false;
+                }
+                continue;
+            }
+
+            switch (c)
+            {
+                case '"':
+                    inString = true;
+                    builder.Append(c);
+                    break;
+
+                case '{', '[':
+                    // An empty object or array stays on one line
+                    nextPos = DYLO_JsonFormatter::nextNonSpace(_json, pos + 1, length);
+                    nextChar = nextPos ? subStr(_json, nextPos, 1) : '';
+                    if ((c == '{' && nextChar == '}') || (c == '[' && nextChar == ']'))
+                    {
+                        builder.Append(c + nextChar);
+                        pos = nextPos;
+                    }
+                    else
+                    {
+                        indent++;
+                        builder.Append(c);
+                        builder.Append(DYLO_JsonFormatter::newLine(indent));
+                    }
+                    break;
+
+                case '}', ']':
+                    indent = max(indent - 1, 0);
+                    builder.Append(DYLO_JsonFormatter::newLine(indent));
+                    builder.Append(c);
+                    break;
+
+                case ',':
+                    builder.Append(c);
+                    builder.Append(DYLO_JsonFormatter::newLine(indent));
+                    break;
+
+                case ':':
+                    builder.Append(': ');
+                    break;
+
+                case ' ', '\t', '\n', '\r':
+                    // Whitespace outside strings is replaced by the formatting
+                    break;
+
+                default:
+                    builder.Append(c);
+                    break;
+            }
+        }
+
+        return builder.ToString();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>newLine</Name>
+				<Source><![CDATA[
+    private static str newLine(int _indent)
+    {
+        return '\n' + strRep(' ', _indent * 2);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>nextNonSpace</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Finds the position of the next character that is not whitespace; 0 when there is none.
+    /// </summary>
+    private static int nextNonSpace(str _json, int _from, int _length)
+    {
+        int pos;
+        str c;
+
+        for (pos = _from; pos <= _length; pos++)
+        {
+            c = subStr(_json, pos, 1);
+            if (c != ' ' && c != '\t' && c != '\n' && c != '\r')
+            {
+                return pos;
+            }
+        }
+
+        return 0;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiLineContract.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiLineContract.xml
new file mode 100644
index 0000000..cb9fcb6
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiLineContract.xml
@@ -0,0 +1,144 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_SalesOrderApiLineContract</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// One order line of the inbound sales order API request.
+/// </summary>
+[DataContractAttribute]
+public class DYLO_SalesOrderApiLineContract
+{
+    ItemId              itemId;
+    Qty                 qty;
+    UnitOfMeasureSymbol unit;
+    InventSiteId        site;
+    InventLocationId    warehouse;
+    Price               unitPrice;
+    boolean             unitPriceAssigned;
+    str                 hasUnitPriceText;
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>parmItemId</Name>
+				<Source><![CDATA[
+    [DataMemberAttribute('itemId')]
+    public ItemId parmItemId(ItemId _itemId = itemId)
+    {
+        itemId = _itemId;
+        return itemId;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>parmQty</Name>
+				<Source><![CDATA[
+    [DataMemberAttribute('qty')]
+    public Qty parmQty(Qty _qty = qty)
+    {
+        qty = _qty;
+        return qty;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>parmUnit</Name>
+				<Source><![CDATA[
+    [DataMemberAttribute('unit')]
+    public UnitOfMeasureSymbol parmUnit(UnitOfMeasureSymbol _unit = unit)
+    {
+        unit = _unit;
+        return unit;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>parmSite</Name>
+				<Source><![CDATA[
+    [DataMemberAttribute('site')]
+    public InventSiteId parmSite(InventSiteId _site = site)
+    {
+        site = _site;
+        return site;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>parmWarehouse</Name>
+				<Source><![CDATA[
+    [DataMemberAttribute('warehouse')]
+    public InventLocationId parmWarehouse(InventLocationId _warehouse = warehouse)
+    {
+        warehouse = _warehouse;
+        return warehouse;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>parmUnitPrice</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// The unit price override. Assigning a value marks the price as sent, so a price of 0 is told apart from no price.
+    /// </summary>
+    [DataMemberAttribute('unitPrice')]
+    public Price parmUnitPrice(Price _unitPrice = unitPrice)
+    {
+        if (!prmIsDefault(_unitPrice))
+        {
+            unitPrice         = _unitPrice;
+            unitPriceAssigned = true;
+        }
+
+        return unitPrice;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>parmHasUnitPrice</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Whether a unit price override was sent ('true' or 'false').
+    /// Written to the stored request so that reprocessing reads the same answer back;
+    /// a caller does not need to send it, it follows from unitPrice.
+    /// </summary>
+    [DataMemberAttribute('hasUnitPrice')]
+    public str parmHasUnitPrice(str _hasUnitPrice = hasUnitPriceText)
+    {
+        if (!prmIsDefault(_hasUnitPrice))
+        {
+            hasUnitPriceText = _hasUnitPrice;
+        }
+
+        return this.hasUnitPrice() ? 'true' : 'false';
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>hasUnitPrice</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Determines whether a unit price override was sent.
+    /// </summary>
+    public boolean hasUnitPrice()
+    {
+        if (hasUnitPriceText)
+        {
+            return hasUnitPriceText == 'true';
+        }
+
+        return unitPriceAssigned;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiOrderCreator.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiOrderCreator.xml
new file mode 100644
index 0000000..55c2001
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiOrderCreator.xml
@@ -0,0 +1,132 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_SalesOrderApiOrderCreator</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Creates the sales order of a validated inbound sales order API request, in one transaction.
+/// </summary>
+public class DYLO_SalesOrderApiOrderCreator
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>construct</Name>
+				<Source><![CDATA[
+    public static DYLO_SalesOrderApiOrderCreator construct()
+    {
+        return new DYLO_SalesOrderApiOrderCreator();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>create</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Creates the sales order header and lines.
+    /// </summary>
+    /// <param name = "_request">The validated request.</param>
+    /// <returns>The ID of the new sales order.</returns>
+    public SalesId create(DYLO_SalesOrderApiRequestContract _request)
+    {
+        SalesTable      salesTable;
+        ListEnumerator  enumerator;
+
+        ttsbegin;
+
+        salesTable.clear();
+        salesTable.initValue();
+        salesTable.SalesId     = NumberSeq::newGetNum(SalesParameters::numRefSalesId()).num();
+        salesTable.CustAccount = _request.parmCustomerAccount();
+        salesTable.initFromCustTable();
+
+        if (_request.parmCurrency())
+        {
+            salesTable.CurrencyCode = _request.parmCurrency();
+        }
+
+        salesTable.PurchOrderFormNum = _request.parmCustomerPoReference();
+
+        if (_request.parmRequestedShipDate())
+        {
+            salesTable.ShippingDateRequested = _request.parmRequestedShipDate();
+        }
+
+        if (!salesTable.validateWrite())
+        {
+            throw error(strFmt("@DYLOExtensions:SOApiErrHeaderRejected", salesTable.CustAccount));
+        }
+
+        salesTable.insert();
+
+        enumerator = _request.parmLines().getEnumerator();
+        while (enumerator.moveNext())
+        {
+            this.createLine(salesTable, enumerator.current(), _request.parmRequestedShipDate());
+        }
+
+        ttscommit;
+
+        return salesTable.SalesId;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>createLine</Name>
+				<Source><![CDATA[
+    private void createLine(SalesTable _salesTable, DYLO_SalesOrderApiLineContract _line, TransDate _requestedShipDate)
+    {
+        SalesLine   salesLine;
+        InventDim   inventDim;
+
+        salesLine.clear();
+        salesLine.SalesId = _salesTable.SalesId;
+        salesLine.ItemId  = _line.parmItemId();
+
+        if (_line.parmSite() || _line.parmWarehouse())
+        {
+            if (_line.parmSite())
+            {
+                inventDim.InventSiteId = _line.parmSite();
+            }
+
+            if (_line.parmWarehouse())
+            {
+                inventDim.InventLocationId = _line.parmWarehouse();
+            }
+
+            salesLine.InventDimId = InventDim::findOrCreate(inventDim).inventDimId;
+        }
+
+        salesLine.SalesQty = _line.parmQty();
+
+        if (_line.parmUnit())
+        {
+            salesLine.SalesUnit = _line.parmUnit();
+        }
+
+        if (_requestedShipDate)
+        {
+            salesLine.ShippingDateRequested = _requestedShipDate;
+        }
+
+        salesLine.createLine(true, true, true, true, true, true);
+
+        if (_line.hasUnitPrice())
+        {
+            salesLine = SalesLine::findRecId(salesLine.RecId, true);
+            salesLine.SalesPrice = _line.parmUnitPrice();
+            salesLine.PriceUnit  = 1;
+            salesLine.LineAmount = salesLine.calcLineAmount();
+            salesLine.update();
+        }
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiProcessor.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiProcessor.xml
new file mode 100644
index 0000000..66dcbc8
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiProcessor.xml
@@ -0,0 +1,216 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_SalesOrderApiProcessor</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Processes an inbound sales order API request in the current legal entity:
+/// payload check, duplicate check, validation and creation. Used by the service and by reprocessing.
+/// </summary>
+public class DYLO_SalesOrderApiProcessor
+{
+    public const str ErrPayloadInvalid      = 'PAYLOAD_INVALID';
+    public const str ErrLegalEntityNotFound = 'LE_NOT_FOUND';
+    public const str ErrCreateFailed        = 'CREATE_FAILED';
+    public const str ErrUnexpected          = 'UNEXPECTED';
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>process</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Processes the request.
+    /// </summary>
+    /// <param name = "_request">The request.</param>
+    /// <returns>The response.</returns>
+    public static DYLO_SalesOrderApiResponseContract process(DYLO_SalesOrderApiRequestContract _request)
+    {
+        DYLO_SalesOrderApiResponseContract  response = DYLO_SalesOrderApiResponseContract::newFromRequest(_request);
+        DYLO_SalesOrderApiTrace             original;
+        List                                validationErrors;
+        ListEnumerator                      enumerator;
+        DYLO_ApiErrorCode                   errorCode;
+        str                                 errorMessage;
+        SalesId                             salesId;
+        int                                 infologStart;
+
+        // 1. Payload check
+        if (!DYLO_SalesOrderApiProcessor::checkPayload(_request, response))
+        {
+            response.setFailed();
+            return response;
+        }
+
+        // 2. Duplicate check
+        original = DYLO_SalesOrderApiTrace::findLastSuccessByExtRef(_request.parmExternalOrderId());
+        if (original.RecId)
+        {
+            response.setSuccess(original.SalesId, true);
+            return response;
+        }
+
+        // 3. Validation
+        validationErrors = DYLO_SalesOrderApiValidator::construct().validate(_request);
+        if (!validationErrors.empty())
+        {
+            enumerator = validationErrors.getEnumerator();
+            while (enumerator.moveNext())
+            {
+                [errorCode, errorMessage] = enumerator.current();
+                response.addError(errorCode, errorMessage);
+            }
+
+            response.setFailed();
+            return response;
+        }
+
+        // 4. Creation; everything is rolled back on failure
+        infologStart = infologLine();
+        try
+        {
+            salesId = DYLO_SalesOrderApiOrderCreator::construct().create(_request);
+            response.setSuccess(salesId, false);
+        }
+        catch
+        {
+            DYLO_SalesOrderApiProcessor::addInfologErrors(response, DYLO_SalesOrderApiProcessor::ErrCreateFailed, infologStart, "@DYLOExtensions:SOApiErrCreateFailed");
+            response.setFailed();
+        }
+
+        return response;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>checkPayload</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Checks that the mandatory members and at least one line are present.
+    /// </summary>
+    private static boolean checkPayload(DYLO_SalesOrderApiRequestContract _request, DYLO_SalesOrderApiResponseContract _response)
+    {
+        boolean ok = true;
+
+        if (!_request)
+        {
+            _response.addError(DYLO_SalesOrderApiProcessor::ErrPayloadInvalid, strFmt("@DYLOExtensions:SOApiErrPayloadMissingField", '_request'));
+            return false;
+        }
+
+        if (!_request.parmCorrelationId())
+        {
+            _response.addError(DYLO_SalesOrderApiProcessor::ErrPayloadInvalid, strFmt("@DYLOExtensions:SOApiErrPayloadMissingField", 'correlationId'));
+            ok = false;
+        }
+
+        if (!_request.parmExternalOrderId())
+        {
+            _response.addError(DYLO_SalesOrderApiProcessor::ErrPayloadInvalid, strFmt("@DYLOExtensions:SOApiErrPayloadMissingField", 'externalOrderId'));
+            ok = false;
+        }
+
+        if (!_request.parmCustomerAccount())
+        {
+            _response.addError(DYLO_SalesOrderApiProcessor::ErrPayloadInvalid, strFmt("@DYLOExtensions:SOApiErrPayloadMissingField", 'customerAccount'));
+            ok = false;
+        }
+
+        if (_request.lineCount() == 0)
+        {
+            _response.addError(DYLO_SalesOrderApiProcessor::ErrPayloadInvalid, "@DYLOExtensions:SOApiErrPayloadNoLines");
+            ok = false;
+        }
+
+        return ok;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>newUnexpectedResponse</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Builds a failed response with code UNEXPECTED for an exception that was not handled.
+    /// </summary>
+    /// <param name = "_request">The request; may be null.</param>
+    /// <param name = "_infologStart">The infolog line before the call started.</param>
+    /// <param name = "_clrError">true when the exception was a CLR error.</param>
+    public static DYLO_SalesOrderApiResponseContract newUnexpectedResponse(
+        DYLO_SalesOrderApiRequestContract _request,
+        int                               _infologStart,
+        boolean                           _clrError = false)
+    {
+        DYLO_SalesOrderApiResponseContract  response = DYLO_SalesOrderApiResponseContract::newFromRequest(_request);
+        System.Exception                    clrException;
+        str                                 clrMessage;
+
+        if (_clrError)
+        {
+            clrException = CLRInterop::getLastException();
+            if (clrException)
+            {
+                clrMessage = clrException.Message;
+                if (clrException.InnerException)
+                {
+                    clrMessage = clrException.InnerException.Message;
+                }
+            }
+        }
+
+        if (clrMessage)
+        {
+            response.addError(DYLO_SalesOrderApiProcessor::ErrUnexpected, strFmt("@DYLOExtensions:SOApiErrUnexpected", clrMessage));
+        }
+        else
+        {
+            DYLO_SalesOrderApiProcessor::addInfologErrors(response, DYLO_SalesOrderApiProcessor::ErrUnexpected, _infologStart, strFmt("@DYLOExtensions:SOApiErrUnexpected", ''));
+        }
+
+        response.setFailed();
+
+        return response;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>addInfologErrors</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Adds the infolog messages written since a given line as errors; adds a default message when there are none.
+    /// </summary>
+    private static void addInfologErrors(
+        DYLO_SalesOrderApiResponseContract  _response,
+        DYLO_ApiErrorCode                   _errorCode,
+        int                                 _infologStart,
+        str                                 _defaultMessage)
+    {
+        SysInfologEnumerator    infologEnumerator;
+        boolean                 added;
+
+        if (infologLine() > _infologStart)
+        {
+            infologEnumerator = SysInfologEnumerator::newData(infolog.copy(_infologStart + 1, infologLine()));
+            while (infologEnumerator.moveNext())
+            {
+                if (infologEnumerator.currentMessage())
+                {
+                    _response.addError(_errorCode, infologEnumerator.currentMessage());
+                    added = true;
+                }
+            }
+        }
+
+        if (!added)
+        {
+            _response.addError(_errorCode, _defaultMessage);
+        }
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiPurgeContract.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_SalesOrderApiPurgeContract.xml
