+<?xml version="1.0" encoding="utf-8"?>
+<AxForm xmlns:i="http://www.w3.org/2001/XMLSchema-instance" xmlns="Microsoft.Dynamics.AX.Metadata.V6">
+	<Name>DYLO_SalesOrderApiPayloadView</Name>
+	<SourceCode>
+		<Methods xmlns="">
+			<Method>
+				<Name>classDeclaration</Name>
+				<Source><![CDATA[
+/// <summary>
+/// Shows the request and response JSON of a sales order API trace record in a large viewer.
+/// </summary>
+[Form]
+public class DYLO_SalesOrderApiPayloadView extends FormRun
+{
+}
+]]></Source>
+			</Method>
+			<Method>
+				<Name>init</Name>
+				<Source><![CDATA[
+    public void init()
+    {
+        DYLO_SalesOrderApiTrace trace;
+
+        if (!element.args() || !element.args().record() || element.args().dataset() != tableNum(DYLO_SalesOrderApiTrace))
+        {
+            throw error("@DYLOExtensions:SOApiReprocessNoRecord");
+        }
+
+        super();
+
+        trace = element.args().record();
+
+        element.design().caption(strFmt("@DYLOExtensions:SOApiPayloadViewCaption", trace.CorrelationId));
+        RequestJsonView.text(trace.RequestJson);
+        ResponseJsonView.text(trace.ResponseJson);
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+		<DataSources xmlns="" />
+		<DataControls xmlns="" />
+		<Members xmlns="" />
+	</SourceCode>
+	<DataSources />
+	<Design>
+		<Caption xmlns="">@DYLOExtensions:SOApiViewJsonPayload</Caption>
+		<DialogSize xmlns="">Medium</DialogSize>
+		<Pattern xmlns="">DialogReadOnly</Pattern>
+		<PatternVersion xmlns="">1.2</PatternVersion>
+		<Style xmlns="">Dialog</Style>
+		<ViewEditMode xmlns="">View</ViewEditMode>
+		<Controls xmlns="">
+			<AxFormControl xmlns=""
+				i:type="AxFormGroupControl">
+				<Name>RequestJsonGroup</Name>
+				<HeightMode>SizeToContent</HeightMode>
+				<Pattern>FillText</Pattern>
