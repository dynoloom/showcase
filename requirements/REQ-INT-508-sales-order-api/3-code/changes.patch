+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// One record for each call of the inbound sales order API (REQ-INT-508).
+/// </summary>
+public class DYLO_SalesOrderApiTrace extends common
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>canReprocess</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Determines whether the call can be reprocessed.
+    /// </summary>
+    /// <returns>true when the call failed; otherwise, false.</returns>
+    public boolean canReprocess()
+    {
+        return this.RecId != 0 && this.Status == DYLO_SalesOrderApiStatus::Failed;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>findRecId</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Finds a trace record by its record ID.
+    /// </summary>
+    public static DYLO_SalesOrderApiTrace findRecId(RecId _recId, boolean _forUpdate = false)
+    {
+        DYLO_SalesOrderApiTrace trace;
+
+        if (_recId)
+        {
+            trace.selectForUpdate(_forUpdate);
+
+            select firstonly trace
+                where trace.RecId == _recId;
+        }
+
+        return trace;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>findLastSuccessByExtRef</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Finds the newest successful or reprocessed call for an external order reference whose sales order still exists.
+    /// </summary>
+    /// <param name = "_externalOrderRef">The external order reference.</param>
+    /// <returns>The trace record; an empty buffer when there is none.</returns>
+    public static DYLO_SalesOrderApiTrace findLastSuccessByExtRef(DYLO_ExternalOrderRef _externalOrderRef)
+    {
+        DYLO_SalesOrderApiTrace trace;
+        DYLO_SalesOrderApiTrace notFound;
+
+        if (_externalOrderRef)
+        {
+            while select trace
+                order by ExecutedDateTime desc
+                where trace.ExternalOrderRef == _externalOrderRef
+                   && (trace.Status == DYLO_SalesOrderApiStatus::Success
+                    || trace.Status == DYLO_SalesOrderApiStatus::Reprocessed)
+            {
+                if (trace.SalesId && SalesTable::exist(trace.SalesId))
+                {
+                    return trace;
+                }
+            }
+        }
+
+        return notFound;
+    }
+
+]]></Source>
+			</Method>
