+						<DisplayHeightMode>Fixed</DisplayHeightMode>
+						<ExtendedDataType>Notes</ExtendedDataType>
+						<MultiLine>Yes</MultiLine>
+						<ShowLabel>No</ShowLabel>
+					</AxFormControl>
+				</Controls>
+				<Caption>@DYLOExtensions:SOApiRequestJson</Caption>
