]]></Declaration>
		<Methods>
			<Method>
				<Name>findByCustInvoiceTrans</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the warranty provision log record of an invoice line.
    /// </summary>
    /// <param name = "_custInvoiceTransRecId">The record ID of the invoice line.</param>
    /// <param name = "_forUpdate">true to select the record for update; optional.</param>
    /// <returns>The log record, or an empty buffer when none is found.</returns>
    public static DYLO_WarrantyProvisionTrans findByCustInvoiceTrans(RefRecId _custInvoiceTransRecId, boolean _forUpdate = false)
    {
        DYLO_WarrantyProvisionTrans provisionTrans;

        if (_custInvoiceTransRecId)
        {
            provisionTrans.selectForUpdate(_forUpdate);

            select firstonly provisionTrans
                where provisionTrans.CustInvoiceTransRecId == _custInvoiceTransRecId;
        }

        return provisionTrans;
    }

]]></Source>
			</Method>
		</Methods>
