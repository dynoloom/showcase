diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_WarrantyProvisionPostingService.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_WarrantyProvisionPostingService.xml
new file mode 100644
index 0000000..a4a5d82
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_WarrantyProvisionPostingService.xml
@@ -0,0 +1,235 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_WarrantyProvisionPostingService</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Adds the warranty expense and warranty provision lines of one sales invoice line
+/// to the invoice's own ledger voucher and logs the posted provision.
+/// </summary>
+public final class DYLO_WarrantyProvisionPostingService
+{
+    /// <summary>
+    /// The default warranty provision % of released products.
+    /// </summary>
+    public const DYLO_WarrantyProvisionPct DYLO_WarrantyDefaultPct = 3.50;
+
+    LedgerVoucher           ledgerVoucher;
+    CustInvoiceJour         custInvoiceJour;
+    CustInvoiceTrans        custInvoiceTrans;
+    SalesParmLine           salesParmLine;
+    AmountCur               lineValue;
+    CurrencyCode            currencyCode;
+    CurrencyExchangeHelper  exchangeRateHelper;
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>new</Name>
+				<Source><![CDATA[
+    protected void new()
+    {
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>construct</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Creates the posting service for one invoice line.
+    /// </summary>
+    /// <param name = "_ledgerVoucher">The invoice's ledger voucher.</param>
+    /// <param name = "_custInvoiceJour">The invoice journal header.</param>
+    /// <param name = "_custInvoiceTrans">The invoice journal line.</param>
+    /// <param name = "_salesParmLine">The posting parameter line.</param>
+    /// <param name = "_lineValue">The line net amount excluding sales tax, in the invoice currency.</param>
+    /// <param name = "_currencyCode">The invoice currency.</param>
+    /// <param name = "_exchangeRateHelper">The exchange rates of the invoice line's revenue.</param>
+    /// <returns>A new instance of the service.</returns>
+    public static DYLO_WarrantyProvisionPostingService construct(
+        LedgerVoucher           _ledgerVoucher,
+        CustInvoiceJour         _custInvoiceJour,
+        CustInvoiceTrans        _custInvoiceTrans,
+        SalesParmLine           _salesParmLine,
+        AmountCur               _lineValue,
+        CurrencyCode            _currencyCode,
+        CurrencyExchangeHelper  _exchangeRateHelper)
+    {
+        DYLO_WarrantyProvisionPostingService service = new DYLO_WarrantyProvisionPostingService();
+
+        service.ledgerVoucher       = _ledgerVoucher;
+        service.custInvoiceJour     = _custInvoiceJour;
+        service.custInvoiceTrans    = _custInvoiceTrans;
+        service.salesParmLine       = _salesParmLine;
+        service.lineValue           = _lineValue;
+        service.currencyCode        = _currencyCode;
+        service.exchangeRateHelper  = _exchangeRateHelper;
+
+        return service;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>post</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Posts the warranty provision of the invoice line, when the item is warranty eligible.
+    /// </summary>
+    public void post()
+    {
+        if (!custInvoiceTrans.ItemId || !ledgerVoucher)
+        {
+            return;
+        }
+
+        InventTable item = custInvoiceTrans.inventTable();
+
+        if (!item.RecId || item.DYLO_WarrantyEligible == NoYes::No)
+        {
+            return;
+        }
+
+        boolean hasPct;
+        DYLO_WarrantyProvisionPct pct;
+        [hasPct, pct] = this.provisionPct(item);
+
+        if (!hasPct)
+        {
+            return;
+        }
+
+        ItemGroupId groupId = item.itemGroupId();
+        DYLO_WarrantyPostingSetup setup = DYLO_WarrantyPostingSetup::find(groupId);
+
+        if (!setup.RecId || !setup.ExpenseLedgerDimension || !setup.ProvisionLedgerDimension)
+        {
+            throw error(strFmt("@DYLOExtensions:WarrantyProvisionSetupMissing", groupId, item.ItemId));
+        }
+
+        AmountCur amount = CurrencyExchangeHelper::amount(lineValue * pct / 100, currencyCode);
+
+        if (!amount)
+        {
+            return;
+        }
+
+        DimensionDefault dim = custInvoiceTrans.DefaultDimension;
+        LedgerDimensionAccount expenseDim   = LedgerDimensionFacade::serviceCreateLedgerDimension(setup.ExpenseLedgerDimension, dim);
+        LedgerDimensionAccount provisionDim = LedgerDimensionFacade::serviceCreateLedgerDimension(setup.ProvisionLedgerDimension, dim);
+
+        LedgerVoucherObject ledgerVoucherObject = ledgerVoucher.findLedgerVoucherObject();
+
+        LedgerVoucherTransObject expenseTrans = LedgerVoucherTransObject::newTransactionAmountDefault(
+            ledgerVoucherObject,
+            LedgerPostingType::DYLO_WarrantyExpense,
+            expenseDim,
+            currencyCode,
+            amount,
+            exchangeRateHelper);
+        expenseTrans.parmText(strFmt("@DYLOExtensions:WarrantyProvisionAccrualTxt", custInvoiceJour.InvoiceId));
+        expenseTrans.parmSourceTableId(custInvoiceTrans.TableId);
+        expenseTrans.parmSourceRecId(custInvoiceTrans.RecId);
+
+        LedgerVoucherTransObject provisionTrans = LedgerVoucherTransObject::newTransactionAmountDefault(
+            ledgerVoucherObject,
+            LedgerPostingType::DYLO_WarrantyProvision,
+            provisionDim,
+            currencyCode,
+            -amount,
+            exchangeRateHelper);
+        provisionTrans.parmText(strFmt("@DYLOExtensions:WarrantyProvisionReserveTxt", custInvoiceJour.InvoiceId));
+        provisionTrans.parmSourceTableId(custInvoiceTrans.TableId);
+        provisionTrans.parmSourceRecId(custInvoiceTrans.RecId);
+
+        ledgerVoucher.addTrans(expenseTrans);
+        ledgerVoucher.addTrans(provisionTrans);
+
+        Voucher voucher = custInvoiceJour.LedgerVoucher ? custInvoiceJour.LedgerVoucher : ledgerVoucherObject.parmVoucher();
+
+        this.insertLog(item.ItemId, pct, amount, voucher, expenseDim, provisionDim);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>provisionPct</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Determines the provision % of the invoice line.
+    /// </summary>
+    /// <param name = "_item">The released product of the line.</param>
+    /// <returns>
+    /// A container with a flag that is false when nothing must be posted, and the provision %.
+    /// </returns>
+    /// <remarks>
+    /// A credit note line that is linked to an original invoice line uses the % logged on that invoice;
+    /// when the original invoice has no log, there is nothing to reverse.
+    /// </remarks>
+    private container provisionPct(InventTable _item)
+    {
+        InventTransId returnLotId = salesParmLine.salesLine().InventTransIdReturn;
+
+        if (returnLotId)
+        {
+            CustInvoiceTrans originalTrans;
+            DYLO_WarrantyProvisionTrans originalLog;
+
+            select firstonly RecId, ProvisionPct from originalLog
+                order by originalLog.InvoiceDate desc
+                exists join originalTrans
+                    where originalTrans.RecId == originalLog.CustInvoiceTransRecId
+                        && originalTrans.InventTransId == returnLotId;
+
+            if (originalLog.RecId)
+            {
+                return [true, originalLog.ProvisionPct];
+            }
+
+            select firstonly RecId from originalTrans
+                where originalTrans.InventTransId == returnLotId;
+
+            if (originalTrans.RecId)
+            {
+                // The original invoice posted no warranty provision: nothing to reverse.
+                return [false, 0];
+            }
+        }
+
+        return [true, _item.DYLO_WarrantyProvisionPct];
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>insertLog</Name>
+				<Source><![CDATA[
+    private void insertLog(
+        ItemId                      _itemId,
+        DYLO_WarrantyProvisionPct   _pct,
+        AmountCur                   _amount,
+        Voucher                     _voucher,
+        LedgerDimensionAccount      _expenseDim,
+        LedgerDimensionAccount      _provisionDim)
+    {
+        DYLO_WarrantyProvisionTrans provisionLog;
+
+        provisionLog.CustInvoiceTransRecId      = custInvoiceTrans.RecId;
+        provisionLog.InvoiceId                  = custInvoiceJour.InvoiceId;
+        provisionLog.InvoiceDate                = custInvoiceJour.InvoiceDate;
+        provisionLog.Voucher                    = _voucher;
+        provisionLog.ItemId                     = _itemId;
+        provisionLog.ProvisionPct               = _pct;
+        provisionLog.AmountCur                  = _amount;
+        provisionLog.CurrencyCode               = currencyCode;
+        provisionLog.ExpenseLedgerDimension     = _expenseDim;
+        provisionLog.ProvisionLedgerDimension   = _provisionDim;
+        provisionLog.insert();
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_WarrantyProvisionPostingTest.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_WarrantyProvisionPostingTest.xml
new file mode 100644
index 0000000..a516629
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_WarrantyProvisionPostingTest.xml
@@ -0,0 +1,271 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_WarrantyProvisionPostingTest</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Unit tests for <c>DYLO_WarrantyProvisionPostingService</c>.
+/// </summary>
+[
+SysTestTarget(classStr(DYLO_WarrantyProvisionPostingService), UtilElementType::Class),
+SysTestGranularity(SysTestGranularity::Unit)
+]
+public final class DYLO_WarrantyProvisionPostingTest extends SysTestCase
+{
+    const ItemId            TestItemId          = 'DYLOWTYITEM';
+    const ItemGroupId       TestItemGroupId     = 'DYLOWTYGRP';
+    const InvoiceId         TestInvoiceId       = 'DYLOWTYINV';
+    const Voucher           TestVoucher         = 'DYLOWTYVOU';
+
+    CurrencyCode            currencyCode;
+    TransDate               testDate;
+    LedgerVoucher           ledgerVoucher;
+    CustInvoiceJour         custInvoiceJour;
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>setUp</Name>
+				<Source><![CDATA[
+    public void setUp()
+    {
+        super();
+
+        testDate     = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
+        currencyCode = Ledger::accountingCurrency(CompanyInfo::current());
+
+        ledgerVoucher = LedgerVoucher::newLedgerPost(DetailSummary::Detail, SysModule::Cust, '');
+        ledgerVoucher.addVoucher(LedgerVoucherObject::newVoucher(TestVoucher, testDate, SysModule::Cust, LedgerTransType::Cust));
+
+        custInvoiceJour.InvoiceId       = TestInvoiceId;
+        custInvoiceJour.InvoiceDate     = testDate;
+        custInvoiceJour.LedgerVoucher   = TestVoucher;
+        custInvoiceJour.CurrencyCode    = currencyCode;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>createItem</Name>
+				<Source><![CDATA[
+    private void createItem(DYLO_WarrantyProvisionPct _pct, boolean _withGroup = true)
+    {
+        InventTable inventTable;
+        inventTable.ItemId                      = TestItemId;
+        inventTable.DYLO_WarrantyEligible       = NoYes::Yes;
+        inventTable.DYLO_WarrantyProvisionPct   = _pct;
+        inventTable.doInsert();
+
+        if (_withGroup)
+        {
+            InventItemGroup inventItemGroup;
+            inventItemGroup.ItemGroupId = TestItemGroupId;
+            inventItemGroup.doInsert();
+
+            InventItemGroupItem inventItemGroupItem;
+            inventItemGroupItem.ItemId              = TestItemId;
+            inventItemGroupItem.ItemDataAreaId      = curExt();
+            inventItemGroupItem.ItemGroupId         = TestItemGroupId;
+            inventItemGroupItem.ItemGroupDataAreaId = curExt();
+            inventItemGroupItem.doInsert();
+        }
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>createSetup</Name>
+				<Source><![CDATA[
+    private void createSetup()
+    {
+        MainAccount expenseAccount;
+        MainAccount provisionAccount;
+
+        select firstonly MainAccountId from expenseAccount
+            order by expenseAccount.MainAccountId asc
+            where expenseAccount.LedgerChartOfAccounts == LedgerChartOfAccounts::current();
+
+        select firstonly MainAccountId from provisionAccount
+            order by provisionAccount.MainAccountId desc
+            where provisionAccount.LedgerChartOfAccounts == LedgerChartOfAccounts::current();
+
+        DYLO_WarrantyPostingSetup setup;
+        setup.ItemGroupId               = TestItemGroupId;
+        setup.ExpenseLedgerDimension    = LedgerDefaultAccountHelper::getDefaultAccountFromMainAccountId(expenseAccount.MainAccountId);
+        setup.ProvisionLedgerDimension  = LedgerDefaultAccountHelper::getDefaultAccountFromMainAccountId(provisionAccount.MainAccountId);
+        setup.doInsert();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>createInvoiceTrans</Name>
+				<Source><![CDATA[
+    private CustInvoiceTrans createInvoiceTrans(InventTransId _inventTransId)
+    {
+        CustInvoiceTrans custInvoiceTrans;
+        custInvoiceTrans.InvoiceId      = TestInvoiceId;
+        custInvoiceTrans.InvoiceDate    = testDate;
+        custInvoiceTrans.ItemId         = TestItemId;
+        custInvoiceTrans.InventTransId  = _inventTransId;
+        custInvoiceTrans.CurrencyCode   = currencyCode;
+        custInvoiceTrans.doInsert();
+
+        return custInvoiceTrans;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>post</Name>
+				<Source><![CDATA[
+    private DYLO_WarrantyProvisionTrans post(CustInvoiceTrans _custInvoiceTrans, AmountCur _lineValue)
+    {
+        SalesParmLine salesParmLine;
+        salesParmLine.InventTransId = _custInvoiceTrans.InventTransId;
+
+        CurrencyExchangeHelper exchangeRateHelper = CurrencyExchangeHelper::newExchangeDate(Ledger::current(), testDate);
+
+        DYLO_WarrantyProvisionPostingService::construct(
+            ledgerVoucher,
+            custInvoiceJour,
+            _custInvoiceTrans,
+            salesParmLine,
+            _lineValue,
+            currencyCode,
+            exchangeRateHelper).post();
+
+        DYLO_WarrantyProvisionTrans provisionLog;
+        select firstonly provisionLog
+            where provisionLog.CustInvoiceTransRecId == _custInvoiceTrans.RecId;
+
+        return provisionLog;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>testAmountCalculationAndRounding</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// A 40,000.00 line at 3.50% posts 1,400.00; a 333.33 line posts the rounded 11.67.
+    /// </summary>
+    [SysTestMethod]
+    public void testAmountCalculationAndRounding()
+    {
+        this.createItem(3.50);
+        this.createSetup();
+
+        DYLO_WarrantyProvisionTrans provisionLog = this.post(this.createInvoiceTrans('DYLOWTYLOT1'), 40000.00);
+        this.assertEquals(1400.00, provisionLog.AmountCur);
+        this.assertEquals(3.50, provisionLog.ProvisionPct);
+
+        provisionLog = this.post(this.createInvoiceTrans('DYLOWTYLOT2'), 333.33);
+        this.assertEquals(CurrencyExchangeHelper::amount(333.33 * 3.50 / 100, currencyCode), provisionLog.AmountCur);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>testMissingSetupThrowsError</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// An eligible item whose item group has no warranty posting setup stops the posting.
+    /// </summary>
+    [SysTestMethod]
+    public void testMissingSetupThrowsError()
+    {
+        boolean errorThrown;
+
+        this.createItem(3.50);
+
+        try
+        {
+            this.post(this.createInvoiceTrans('DYLOWTYLOT1'), 40000.00);
+        }
+        catch (Exception::Error)
+        {
+            errorThrown = true;
+        }
+
+        this.assertTrue(errorThrown);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>testCreditNoteSign</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// A credit note line with no link to an invoice reverses with the item's current %.
+    /// </summary>
+    [SysTestMethod]
+    public void testCreditNoteSign()
+    {
+        this.createItem(3.50);
+        this.createSetup();
+
+        DYLO_WarrantyProvisionTrans provisionLog = this.post(this.createInvoiceTrans('DYLOWTYLOT1'), -40000.00);
+        this.assertEquals(-1400.00, provisionLog.AmountCur);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>testCreditNoteUsesOriginalPct</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// A credit note line linked to the original invoice line uses the % logged on that invoice.
+    /// </summary>
+    [SysTestMethod]
+    public void testCreditNoteUsesOriginalPct()
+    {
+        this.createItem(3.50);
+        this.createSetup();
+
+        CustInvoiceTrans originalTrans = this.createInvoiceTrans('DYLOWTYORIG');
+
+        DYLO_WarrantyProvisionTrans originalLog;
+        originalLog.CustInvoiceTransRecId   = originalTrans.RecId;
+        originalLog.InvoiceId               = TestInvoiceId;
+        originalLog.InvoiceDate             = testDate;
+        originalLog.ItemId                  = TestItemId;
+        originalLog.ProvisionPct            = 5.00;
+        originalLog.CurrencyCode            = currencyCode;
+        originalLog.doInsert();
+
+        SalesLine returnLine;
+        returnLine.ItemId               = TestItemId;
+        returnLine.InventTransId        = 'DYLOWTYRET';
+        returnLine.InventTransIdReturn  = originalTrans.InventTransId;
+        returnLine.doInsert();
+
+        DYLO_WarrantyProvisionTrans provisionLog = this.post(this.createInvoiceTrans(returnLine.InventTransId), -1000.00);
+        this.assertEquals(-50.00, provisionLog.AmountCur);
+        this.assertEquals(5.00, provisionLog.ProvisionPct);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>testVoucherIsInvoiceVoucher</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// The warranty lines are posted under the invoice's own voucher number.
+    /// </summary>
+    [SysTestMethod]
+    public void testVoucherIsInvoiceVoucher()
+    {
+        this.createItem(3.50);
+        this.createSetup();
+
+        DYLO_WarrantyProvisionTrans provisionLog = this.post(this.createInvoiceTrans('DYLOWTYLOT1'), 40000.00);
+        this.assertEquals(custInvoiceJour.LedgerVoucher, provisionLog.Voucher);
+        this.assertEquals(TestVoucher, ledgerVoucher.findLedgerVoucherObject().parmVoucher());
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/InventTable_DYLO_Extension.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/InventTable_DYLO_Extension.xml
new file mode 100644
index 0000000..a8f7964
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/InventTable_DYLO_Extension.xml
@@ -0,0 +1,64 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>InventTable_DYLO_Extension</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Defaults and validates the warranty provision fields of released products.
+/// </summary>
+[ExtensionOf(tableStr(InventTable))]
+final class InventTable_DYLO_Extension
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>initValue</Name>
+				<Source><![CDATA[
+    public void initValue()
+    {
+        next initValue();
+
+        this.DYLO_WarrantyProvisionPct = DYLO_WarrantyProvisionPostingService::DYLO_WarrantyDefaultPct;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>modifiedField</Name>
+				<Source><![CDATA[
+    public void modifiedField(FieldId _fieldId)
+    {
+        next modifiedField(_fieldId);
+
+        if (_fieldId == fieldNum(InventTable, DYLO_WarrantyEligible)
+            && this.DYLO_WarrantyEligible == NoYes::Yes
+            && this.DYLO_WarrantyProvisionPct == 0)
+        {
+            this.DYLO_WarrantyProvisionPct = DYLO_WarrantyProvisionPostingService::DYLO_WarrantyDefaultPct;
+        }
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>validateWrite</Name>
+				<Source><![CDATA[
+    public boolean validateWrite(boolean _skipProductVariantUnitConversionValidation)
+    {
+        boolean ret = next validateWrite(_skipProductVariantUnitConversionValidation);
+
+        if (this.DYLO_WarrantyEligible == NoYes::Yes
+            && (this.DYLO_WarrantyProvisionPct <= 0 || this.DYLO_WarrantyProvisionPct > 100))
+        {
+            ret = checkFailed(strFmt("@DYLOExtensions:WarrantyProvisionPctInvalid", this.ItemId));
+        }
+
+        return ret;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/SalesInvoiceJournalPostBase_DYLO_Extension.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/SalesInvoiceJournalPostBase_DYLO_Extension.xml
new file mode 100644
index 0000000..20bc670
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/SalesInvoiceJournalPostBase_DYLO_Extension.xml
@@ -0,0 +1,85 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>SalesInvoiceJournalPostBase_DYLO_Extension</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Posts the warranty provision of warranty eligible items in the sales invoice's own voucher.
+/// </summary>
+[ExtensionOf(classStr(SalesInvoiceJournalPostBase))]
+final class SalesInvoiceJournalPostBase_DYLO_Extension
+{
+    private CurrencyExchangeHelper dyloRevenueExchangeRateHelper;
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>createLedgerVoucherTransObject</Name>
+				<Source><![CDATA[
+    protected LedgerVoucherTransObject createLedgerVoucherTransObject(
+        LedgerVoucherObject _ledgerVoucherObject,
+        LedgerDimensionAccount _ledgerDimensionMerged,
+        AmountCur _revenueAmount,
+        CurrencyExchangeHelper _exchangeRateHelper)
+    {
+        // Keep the exchange rates of the revenue line so the warranty lines use exactly the same rates.
+        dyloRevenueExchangeRateHelper = _exchangeRateHelper;
+
+        return next createLedgerVoucherTransObject(_ledgerVoucherObject, _ledgerDimensionMerged, _revenueAmount, _exchangeRateHelper);
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>postLine</Name>
+				<Source><![CDATA[
+    protected void postLine()
+    {
+        dyloRevenueExchangeRateHelper = null;
+
+        next postLine();
+
+        if (this.canSkipPostLine())
+        {
+            return;
+        }
+
+        DYLO_WarrantyProvisionPostingService::construct(
+            ledgerVoucher,
+            custInvoiceJour,
+            custInvoiceTrans,
+            salesParmLine,
+            lineValue,
+            this.currencyCode(),
+            this.dyloExchangeRateHelper()).post();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>dyloExchangeRateHelper</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Returns the exchange rate helper used for the revenue line of the current invoice line,
+    /// or builds one the same way when no revenue line was posted.
+    /// </summary>
+    /// <returns>The exchange rate helper.</returns>
+    private CurrencyExchangeHelper dyloExchangeRateHelper()
+    {
+        if (!dyloRevenueExchangeRateHelper)
+        {
+            dyloRevenueExchangeRateHelper = CurrencyExchangeHelper::newExchangeDate(
+                Ledger::primaryLedger(CompanyInfo::findDataArea(curExt()).RecId),
+                ledgerVoucher.findLedgerVoucherObject().parmAccountingDate());
+            dyloRevenueExchangeRateHelper.parmExchangeRate1(this.fixedExchRate());
+            dyloRevenueExchangeRateHelper.parmExchangeRate2(this.fixedExchRateSecondary());
+        }
+
+        return dyloRevenueExchangeRateHelper;
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
