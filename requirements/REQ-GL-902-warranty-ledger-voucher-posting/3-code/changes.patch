+				<Source><![CDATA[
+    /// <summary>
+    /// Finds the warranty posting setup of an item group.
+    /// </summary>
+    /// <param name = "_itemGroupId">The item group.</param>
+    /// <param name = "_forUpdate">true to select the record for update; optional.</param>
+    /// <returns>The setup record, or an empty buffer when none is found.</returns>
+    public static DYLO_WarrantyPostingSetup find(ItemGroupId _itemGroupId, boolean _forUpdate = false)
+    {
+        DYLO_WarrantyPostingSetup setup;
+
+        if (_itemGroupId)
+        {
+            setup.selectForUpdate(_forUpdate);
+
+            select firstonly setup
+                where setup.ItemGroupId == _itemGroupId;
+        }
+
+        return setup;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>exist</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Checks whether an item group has a warranty posting setup.
+    /// </summary>
+    /// <param name = "_itemGroupId">The item group.</param>
+    /// <returns>true if the setup exists; otherwise, false.</returns>
+    public static boolean exist(ItemGroupId _itemGroupId)
+    {
+        return _itemGroupId
+            && (select firstonly RecId from DYLO_WarrantyPostingSetup
+                    where DYLO_WarrantyPostingSetup.ItemGroupId == _itemGroupId).RecId != 0;
+    }
+
+]]></Source>
