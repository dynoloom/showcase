diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_CustCreditLimitReqWFTypeSubmitManager.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxClass/DYLO_CustCreditLimitReqWFTypeSubmitManager.xml
