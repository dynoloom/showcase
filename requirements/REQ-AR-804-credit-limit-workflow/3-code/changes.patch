diff --git a/Metadata/DYLOExtensions/DYLOExtensions/AxTable/DYLO_CustCreditLimitRequest.xml b/Metadata/DYLOExtensions/DYLOExtensions/AxTable/DYLO_CustCreditLimitRequest.xml
new file mode 100644
index 0000000..f5dc4a0
--- /dev/null
+++ b/Metadata/DYLOExtensions/DYLOExtensions/AxTable/DYLO_CustCreditLimitRequest.xml
@@ -0,0 +1,466 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxTable xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_CustCreditLimitRequest</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// A request to change a customer's credit limit, approved through the credit limit change approval workflow.
+/// </summary>
+public class DYLO_CustCreditLimitRequest extends common
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>initValue</Name>
+				<Source><![CDATA[
+    public void initValue()
+    {
+        super();
+
+        NumberSequenceReference numberSequenceReference = CustParameters::DYLO_numRefCustCreditLimitRequestId();
+        this.RequestId       = NumberSeq::newGetNum(numberSequenceReference).num();
+        this.ApprovalStatus  = DYLO_CustCreditLimitRequestStatus::Draft;
+        this.RequestedBy     = curUserId();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>modifiedField</Name>
+				<Source><![CDATA[
+    public void modifiedField(FieldId _fieldId)
+    {
+        super(_fieldId);
+
+        switch (_fieldId)
+        {
+            case fieldNum(DYLO_CustCreditLimitRequest, CustAccount):
+                this.CurrentCreditMax = CustTable::find(this.CustAccount).CreditMax;
+                this.NetChange        = this.RequestedCreditMax - this.CurrentCreditMax;
+                break;
+
+            case fieldNum(DYLO_CustCreditLimitRequest, RequestedCreditMax):
+                this.NetChange        = this.RequestedCreditMax - this.CurrentCreditMax;
+                break;
+        }
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>validateWrite</Name>
+				<Source><![CDATA[
+    public boolean validateWrite()
+    {
+        boolean ret = super();
+
+        if (ret && this.RecId != 0
+            && this.orig().ApprovalStatus != DYLO_CustCreditLimitRequestStatus::Draft)
+        {
+            ret = checkFailed("@DYLOExtensions:CreditLimitReqErrNotDraft");
+        }
+
+        if (ret && this.RequestedCreditMax < 0)
+        {
+            ret = checkFailed("@DYLOExtensions:CreditLimitReqErrNegative");
+        }
+
+        if (ret)
+        {
+            DYLO_CustCreditLimitRequest openRequest = DYLO_CustCreditLimitRequest::findOpenRequest(this.CustAccount, this.RecId);
+            if (openRequest.RecId)
+            {
+                ret = checkFailed(strFmt("@DYLOExtensions:CreditLimitReqErrOpenRequest", this.CustAccount, openRequest.RequestId));
+            }
+        }
+
+        return ret;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>validateDelete</Name>
+				<Source><![CDATA[
+    public boolean validateDelete()
+    {
+        boolean ret = super();
+
+        if (ret && this.ApprovalStatus != DYLO_CustCreditLimitRequestStatus::Draft)
+        {
+            ret = checkFailed("@DYLOExtensions:CreditLimitReqErrNotDraft");
+        }
+
+        return ret;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>canSubmitToWorkflow</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Determines whether the request can be submitted to workflow.
+    /// </summary>
+    /// <param name = "_workflowType">The workflow type name.</param>
+    /// <returns>true if the request is saved and in Draft; otherwise, false.</returns>
+    public boolean canSubmitToWorkflow(str _workflowType = '')
+    {
+        return this.RecId != 0
+            && this.ApprovalStatus == DYLO_CustCreditLimitRequestStatus::Draft;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>custName</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// The name of the customer of the request.
+    /// </summary>
+    /// <returns>The customer name.</returns>
+    public display CustName custName()
+    {
+        return CustTable::find(this.CustAccount).name();
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>isOpen</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Determines whether the request is open: Draft, Submitted or Pending approval.
+    /// </summary>
+    /// <returns>true if the request is open; otherwise, false.</returns>
+    public boolean isOpen()
+    {
+        return this.ApprovalStatus == DYLO_CustCreditLimitRequestStatus::Draft
+            || this.ApprovalStatus == DYLO_CustCreditLimitRequestStatus::Submitted
+            || this.ApprovalStatus == DYLO_CustCreditLimitRequestStatus::PendingApproval;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>findOpenRequest</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Finds an open request for a customer other than the given record.
+    /// </summary>
+    /// <param name = "_custAccount">The customer account.</param>
+    /// <param name = "_excludeRecId">The record ID of the request to ignore.</param>
+    /// <returns>The open request, or an empty buffer.</returns>
+    public static DYLO_CustCreditLimitRequest findOpenRequest(CustAccount _custAccount, RecId _excludeRecId)
+    {
+        DYLO_CustCreditLimitRequest request;
+
+        if (_custAccount)
+        {
+            select firstonly request
+                where request.CustAccount == _custAccount
+                   && request.RecId != _excludeRecId
+                   && (request.ApprovalStatus == DYLO_CustCreditLimitRequestStatus::Draft
+                    || request.ApprovalStatus == DYLO_CustCreditLimitRequestStatus::Submitted
+                    || request.ApprovalStatus == DYLO_CustCreditLimitRequestStatus::PendingApproval);
+        }
+
+        return request;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>find</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Finds a request by its ID.
+    /// </summary>
+    /// <param name = "_requestId">The request ID.</param>
+    /// <param name = "_forUpdate">true to select the record for update.</param>
+    /// <returns>The request, or an empty buffer.</returns>
+    public static DYLO_CustCreditLimitRequest find(DYLO_CustCreditLimitRequestId _requestId, boolean _forUpdate = false)
+    {
+        DYLO_CustCreditLimitRequest request;
+
+        if (_requestId)
+        {
+            request.selectForUpdate(_forUpdate);
+            select firstonly request where request.RequestId == _requestId;
+        }
+
+        return request;
+    }
+
+]]></Source>
+			</Method>
+			<Method>
+				<Name>findRecId</Name>
+				<Source><![CDATA[
+    /// <summary>
+    /// Finds a request by its record ID.
+    /// </summary>
+    /// <param name = "_recId">The record ID.</param>
+    /// <param name = "_forUpdate">true to select the record for update.</param>
+    /// <returns>The request, or an empty buffer.</returns>
+    public static DYLO_CustCreditLimitRequest findRecId(RecId _recId, boolean _forUpdate = false)
+    {
+        DYLO_CustCreditLimitRequest request;
+
+        if (_recId)
+        {
+            request.selectForUpdate(_forUpdate);
+            select firstonly request where request.RecId == _recId;
+        }
+
+        return request;
+    }
+
+]]></Source>
