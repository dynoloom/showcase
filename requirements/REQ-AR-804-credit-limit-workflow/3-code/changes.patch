@@ -0,0 +1,72 @@
+<?xml version="1.0" encoding="utf-8"?>
+<AxClass xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
+	<Name>DYLO_CustCreditLimitReqApprovalResubmitActionMgr</Name>
+	<SourceCode>
+		<Declaration><![CDATA[
+/// <summary>
+/// Resubmits a credit limit request after an approver requested a change.
+/// </summary>
+public class DYLO_CustCreditLimitReqApprovalResubmitActionMgr
+{
+}
+]]></Declaration>
+		<Methods>
+			<Method>
+				<Name>main</Name>
+				<Source><![CDATA[
+    public static void main(Args _args)
+    {
+        RecId recId = _args.record().RecId;
+        WorkflowWorkItemTable workItem = _args.caller().getActiveWorkflowWorkItem();
+
+        if (workItem)
+        {
+            try
+            {
+                WorkflowWorkItemActionDialog dialog = WorkflowWorkItemActionDialog::construct(
+                    workItem,
+                    WorkflowWorkItemActionType::Resubmit,
+                    new MenuFunction(_args.menuItemName(), _args.menuItemType()));
+                dialog.run();
+
+                if (dialog.parmIsClosedOK())
+                {
+                    ttsbegin;
+
+                    // Refreshes, validates and recalculates the approval path; throws when the request is not valid.
+                    DYLO_CustCreditLimitRequestWFProcessor::prepareSubmit(recId);
+
+                    workItem = _args.caller().getActiveWorkflowWorkItem();
+                    WorkflowWorkItemActionManager::dispatchWorkItemAction(
+                        workItem,
+                        dialog.parmWorkflowComment(),
+                        dialog.parmTargetUser(),
+                        WorkflowWorkItemActionType::Resubmit,
+                        _args.menuItemName());
+
+                    ttscommit;
+
+                    info("@DYLOExtensions:CreditLimitReqResubmitted");
+                }
+            }
+            catch (Exception::Error)
+            {
+                // The validation messages are already in the infolog.
+            }
+        }
+
+        // Make sure the changes in status are reflected on the caller.
+        FormDataSource callerDS = _args.record().dataSource();
+        if (callerDS)
+        {
+            callerDS.reread();
+            callerDS.refresh();
+        }
+        _args.caller().updateWorkflowControls();
+    }
+
+]]></Source>
+			</Method>
+		</Methods>
+	</SourceCode>
+</AxClass>
